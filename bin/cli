#!/bin/bash

# 1. Determinar el binario de PHP a usar
# El `php` del PATH puede estar por debajo del piso declarado en src/composer.json
# (>=8.4.1), y el platform_check de Composer no avisa: bootstrap.php se traga su
# E_USER_ERROR. Con fallback, para no romper donde php8.4 no exista con ese nombre.
if command -v php8.4 >/dev/null 2>&1; then
    PHP_BIN="php8.4"
else
    PHP_BIN="php"
fi

SCRIPT_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
cd "$SCRIPT_DIR/../src"
$PHP_BIN index.php cli --local "$@"
