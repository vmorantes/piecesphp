includes:
    - phpstan.services.neon
    # Sin phpstan/extension-installer, la regla se incluye a mano.
    - tools/vendor/phpstan/phpstan-deprecation-rules/rules.neon
parameters:
    level: 8
    # ATENCIÓN: ESTE RANGO NO HACE LO QUE DECÍA ESTE COMENTARIO.
    #
    # Decía: «con un escalar, PHPStan analiza una sola versión y las deprecaciones de la
    # otra pasan desapercibidas». Es al revés. Con un RANGO, PHPStan reporta solo lo que es
    # error en TODAS las versiones del rango — la INTERSECCIÓN, no la unión. Una deprecación
    # introducida en 8.5 no lo es en 8.4, así que **se descarta en silencio**.
    #
    # MEDIDO, no deducido. Fijando `min: 80500, max: 80500` sobre este mismo árbol:
    #
    #   - aparecen 38 errores que hoy no se ven, y el total pasa de 877 a 900;
    #   - entre ellos, las 3 llamadas a strftime() y el imagedestroy() de sonda, que con el
    #     rango NO se reportan.
    #
    # Y esto explica el fallo entero de la migración: Apache sirve **PHP 8.5.9**, mientras
    # que `bin/phpstan`, `bin/cli` y `bin/rector` corren con **php8.4**. Las nueve llamadas
    # deprecadas eran invisibles para los dos detectores a la vez: para el estático por este
    # rango, y para el de ejecución porque en 8.4 esas funciones no avisan.
    #
    # RESUELTO: `bin/phpstan` YA NO USA ESTE BLOQUE COMO RANGO. Corre DOS PASADAS —una con
    # `phpVersion` fijado en 80400 y otra en 80500, derivadas de este mismo archivo— y el
    # baseline es la UNIÓN de las dos. Reconciliación exacta: 875 instancias en 8.4, menos 9
    # duplicados que la unión deduplica, más 22 tripletas que SOLO existen en 8.5 = 888.
    #
    # Este bloque se conserva porque las dos pasadas lo SUSTITUYEN por su valor fijo: si
    # desaparece, `bin/phpstan` aborta en vez de analizar una sola versión en silencio.
    phpVersion:
        min: 80400 # PHP 8.4 — piso declarado en src/composer.json
        max: 80500 # PHP 8.5 — la versión que sirve Apache
    # EL UNIVERSO ES EL REPOSITORIO ENTERO, y lo que queda fuera se dice abajo. Al revés
    # —enumerar lo que entra— el código nuevo nace invisible y la cifra sale igual de verde
    # midiendo menos. Ver T77 y T79.
    paths:
        - ..
    scanFiles:
        - ../src/app/config/constants.php
    scanDirectories:
        - ../src/app/config
    bootstrapFiles:
        - ../src/vendor/autoload.php
    excludePaths:
        # De terceros: no lo escribimos nosotros.
        - ../src/adminer
        # Dependencias y herramientas descargadas. Todas ignoradas por git.
        - ../src/vendor
        - ../bin/tools/vendor
        - ../bin/tools/phpstan-src
        - ../bin/Preview
        - ../node_modules
        # Generado en tiempo de ejecución.
        - ../src/tmp
    treatPhpDocTypesAsCertain: false
    # Los interruptores de módulo de `src/app/config/constants.php` (regla 8 de
    # CLAUDE.md). CADA DESPLIEGUE los configura, así que su valor NO se conoce en
    # análisis; PHPStan los resolvía al valor de ESTE árbol y daba por muerta toda rama
    # que dependiera de ellos. Borrar esas ramas cablearía los módulos en ENCENDIDO para
    # todos los despliegues, que es la definición de embarcar una trampa.
    #
    # Esto NO es una supresión: no oculta un error, le dice a PHPStan la verdad. Por eso
    # no lleva condición de retirada — la única que la retiraría es que el framework
    # dejase de ser una plantilla que se clona.
    #
    # PROPAGACIÓN COMPROBADA: basta con nombrar la constante global. Una constante de
    # clase asignada desde ella —`const ENABLE = NEWSLETTER_MODULE;`, que es el patrón de
    # todos los `<Modulo>Routes`— también deja de resolverse.
    #
    # Los cuatro paquetes `piecesphp/*` NO llevan este bloque: no ven `constants.php` y
    # ninguno menciona estas constantes (comprobado, cero archivos).
    dynamicConstantNames:
        - ACTIVE_TIMER
        - API_AI_TRANSLATIONS_ACTIVE
        - API_CRONJOBS
        - API_MODULE
        - API_REPORTS
        - API_TRANSLATION_MODULE
        - API_USERS
        - APP_CONFIGURATION_MODULE
        - CONTENT_NAVIGATION_HUB_MODULE
        - DOCUMENTS_MODULE_ENABLE
        - EVENTS_LOG_MODULE
        - FILE_MANAGER_MODULE
        - FORMS_MODULE_CATEGORIES_ENABLE
        - FORMS_MODULE_DOCUMENTS_TYPES_ENABLE
        - FORMS_MODULE_ENABLE
        - HOME_IMAGE_BANNER
        - IMAGES_REPOSITORY
        - IMPORTS_MODULE_ENABLED
        - LOCATIONS_ENABLED
        - NEWSLETTER_MODULE
        - NEWS_MODULE
        - ORGANIZATIONS_MODULE
        - PIECES_PHP_DYNAMIC_IMAGES_ENABLE
        - PUBLICATIONS_MODULE
        - SYSTEM_APPROVALS_MODULE
    ignoreErrors:
        #──── Variables inyectadas en vistas (extract) y elementos difíciles de descrubrir
        -
            message: '#.*#'
            paths:
                - ../src/app/core/psr4/PiecesPHP/Core/PHPStan
        -
            identifiers: 
                - class.notFound
                - variable.undefined
                - echo.nonString
            paths:
                - ../src/app/view/*
                - ../src/app/classes/**/Views/*
        # En BaseMongoModel solo casa class.notFound; incluir los otros dos aquí
        # generaba dos avisos de «patrón no casado», que PHPStan cuenta como errores.
        -
            identifier: class.notFound
            paths:
                - ../src/**/BaseMongoModel.php
        -
            identifiers: 
                - staticMethod.notFound
            paths:
                - ../src/app/classes/SystemApprovals/*
        -
            message: '#.*Constant LOG_ERRORS_PATH not found.*#'
            paths:
                - ../src/app/controller/*
        -
            identifier: argument.unresolvableType
            paths:
                - ../src/app/**/*Mapper.php
        # Las suites de caracterización ejercitan A PROPÓSITO el patrón defectuoso que
        # documentan —encadenar sobre un resultado nulable sin comprobarlo—, así que
        # PHPStan lo señala con razón. Silenciarlo solo ahí mantiene la línea base limpia
        # sin ocultar el mismo patrón en el código de producción.
        -
            identifiers:
                - property.nonObject
                - method.nonObject
            paths:
                - ../src/app/core/system-controllers/local-tests/*
        -
            identifiers: 
                - offsetAccess.nonOffsetAccessible
            paths:
                - ../src/app
        -
            message: '#.*an undefined method (PiecesPHP\\Core\\BaseEntityMapper\|PiecesPHP\\Core\\Database\\ActiveRecordModel).*#'
            paths:
                - ../src/app
        # Tipos no esperados en parámetros

        #──── Generales
        - "#.*protected static method fieldsToSelect.*#"
        - '#.*PHPDoc tag @use has invalid value.*#'
        - '#.*stdClass supplied for foreach.*#' #stdClass marcado como no iterable
        # Validaciones típicas de criterios en ORM
        - '#.*where in empty\(\) always exists.*#'
        - '#.*having in empty\(\) always exists.*#'
        # Conversiones: los seis `cast.*` estuvieron silenciados aquí y se
        # retiraron tras comprobar que no casaban con ningún error (PHPStan los
        # reportaba como «Ignored error pattern … was not matched»).
        # No se reintroducen: `cast.*` significa «Cannot cast X to Y» —operandos
        # inválidos—, no la sintaxis no canónica `(double)`/`(integer)`/
        # `(boolean)`/`(binary)` deprecada en PHP 8.5, que PHPStan no detecta.
        # Esos casts se localizan con Rector o grep, no con este análisis.

        # Declaraciones en docblocks inconsistentes
        - identifier: varTag.variableNotFound 
        - identifier: parameter.notFound 
        - identifier: varTag.nativeType
        -
            identifiers: 
                - new.static
            paths:
                - ../src/app/*
        # Irrelevantes
        - identifier: missingType.iterableValue
        - identifier: missingType.return
        - identifier: missingType.property
        - identifier: missingType.parameter
        - identifier: missingType.generics

        # ── `false` de funciones nativas: lo que SÍ tiene razón ─────────────────────────
        #
        # De los 99 errores visibles que mencionan `false` (el «grupo B»), 14 eran los graves:
        # llamar a un método sobre un `false` es un fatal en ejecución, no un aviso de tipos.
        # Leídos los 14, se parten en dos y NO en una familia:
        #
        #   12 SEGUROS — `DateTime::createFromFormat()` cuyo sujeto es un LITERAL o lo produce
        #   `date()` con un formato compatible: `createFromFormat('Y-m-d H:i:s', date('Y-m-d H:i:00'))`.
        #   El `false` es inalcanzable porque el productor y el formato están los dos en el
        #   mismo sitio y bajo nuestro control. Se suprimen: exigir una rama aquí es pedir un
        #   `if` que nunca se cumple.
        #
        #    3 DEFECTOS — `src/index.php`, donde el sujeto sale del NOMBRE DE UN ARCHIVO del
        #   directorio de sesiones expiradas. Un archivo que no encajara con el patrón devolvía
        #   `false` y reventaba la petición. NO se suprimieron: se arreglaron con su guarda.
        #
        # Los 85 restantes del grupo B NO entran aquí y NO se suprimen: son `false` que llegan
        # como argumento o como retorno, y decidir cuáles son defectos exige leerlos uno a uno
        # sobre datos reales. Van a E2. Ver T41.
        -
            message: '#^Cannot call method [a-zA-Z]+\(\) on DateTime\|false\.$#'
            paths:
                - ../src/app/classes/*

        # ── Condiciones redundantes y código muerto ─────────────────────────────────────
        #
        # 285 tripletas, medidas con `bin/phpstan-deadcode`. NO son un cajón de sastre: cada
        # grupo de abajo lleva su MOTIVO escrito, y el motivo es lo que decide si algún día se
        # retira. El mapa por familias, con la muestra verificada a mano de cada una, está en
        # T29 del doc 18; el reparto por motivo, en T41.
        #
        # La regla que las sostiene (T0): esto NO exige cero errores. Exige cero defectos
        # reales y el resto justificado. Si al leer una de estas ramas se descubre que no hay
        # razón porque es un defecto, ESA SALE DE AQUÍ Y SE ARREGLA.

        # MOTIVO 1 — PROGRAMACIÓN DEFENSIVA SOBRE DATOS QUE EL TIPO NO DESCRIBE (129).
        # `is_array()` sobre algo declarado `array`, `is_scalar($x) && !is_null($x)`,
        # `$array['clave'] ?? null` sobre un literal donde la clave existe. La comprobación es
        # redundante PARA EL TIPO DECLARADO, no para el valor que llega: peticiones, filas de
        # base de datos y JSON entran aquí con el tipo que les dé la gana. Borrarlas por
        # familia es cambiar una guarda real por la confianza en un docblock.
        - identifier: function.alreadyNarrowedType
        - identifier: function.impossibleType
        # `nullCoalesce.offset` se suprime SOLO por el mensaje del `??`, no por identificador:
        # el identificador entero se lleva además un caso que el mensaje no cubre, y bajar el
        # baseline ensanchando una supresión es justo lo que el trinquete no puede premiar.
        - message: '#.*left side of \?\? always exists and is not nullable.*#'

        # MOTIVO 2 — INTERRUPTORES DE MÓDULO Y CONFIGURACIÓN POR DESPLIEGUE (65 medidas).
        # La condición lee una constante de `config/constants.php`, y PHPStan la resuelve al
        # valor DE ESTE ÁRBOL. Cada despliegue configura las suyas. BORRAR ESTAS RAMAS
        # CABLEARÍA TODOS LOS MÓDULOS EN ENCENDIDO, y un despliegue que apague NEWSLETTER_MODULE
        # se rompería sin que nadie pueda ver por qué. Es «embarcar una trampa» en su forma más
        # literal, y por eso este motivo NO tiene condición de retirada.
        - identifier: if.alwaysTrue
        - identifier: booleanNot.alwaysTrue
        - identifier: booleanAnd.rightAlwaysTrue
        - identifier: booleanAnd.leftAlwaysTrue
        - identifier: booleanOr.rightAlwaysTrue
        - identifier: booleanOr.leftAlwaysTrue
        - identifier: booleanAnd.alwaysTrue
        - identifier: identical.alwaysTrue
        - identifier: equal.alwaysTrue
        - identifier: booleanAnd.rightAlwaysFalse
        - identifier: booleanAnd.leftAlwaysFalse
        - identifier: booleanNot.alwaysFalse
        - identifier: booleanOr.rightAlwaysFalse
        - identifier: booleanAnd.alwaysFalse
        #
        # `if.alwaysFalse` sigue acotada por RUTA y no por familia. Las diez de los
        # `<Modulo>Routes` YA NO EXISTEN: eran el interruptor `$showSQL`, y se retiraron al
        # centralizar el DDL en `bin/cli scheme-create`. Medido sin esta supresión: quedan
        # NUEVE, todas fuera de esa carpeta. Se retira cuando se hayan mirado. Ver T24 y T58.
        -
            identifier: if.alwaysFalse
            paths:
                - ../src/app/classes/*
                - ../src/app/core/*

        # MOTIVO 3 — VARIABLES QUE INYECTA EL RENDERIZADOR DE VISTAS (38).
        # Una vista recibe sus variables por `extract()` desde el controlador, así que PHPStan
        # analiza el archivo sin saber que existen. El `isset` y el ternario NO sobran: son lo
        # único que separa una vista incluida con datos de una incluida sin ellos.
        - identifier: isset.variable
        - identifier: ternary.alwaysTrue
        - identifier: ternary.alwaysFalse

        # MOTIVO 4 — ESTRECHAMIENTOS QUE PHPSTAN DA POR HECHOS Y EN EJECUCIÓN NO LO ESTÁN (46).
        # `$userMapper !== null` sobre un valor que la inferencia ya estrechó unas líneas antes.
        # Es una condición VIVA, no un hueco: el estrechamiento viene de un docblock o de un
        # `@var`, y esos mienten con más facilidad que el código. Borrables una a una leyendo de
        # dónde sale el tipo; NO por familia.
        - identifier: notIdentical.alwaysTrue
        - identifier: notIdentical.alwaysFalse
        - identifier: instanceof.alwaysFalse
        - identifier: identical.alwaysFalse

        # MOTIVO 5 — INOFENSIVO Y REAL (4).
        # `break;` detrás de un `return` dentro de un `switch`, casi todo en
        # `SystemApprovalManager`. Es código inalcanzable de verdad y quitarlo no cambia nada,
        # ni para bien ni para mal. Se queda suprimido porque el ruido cuesta más que la rama.
        - identifier: deadCode.unreachable

        # ── PHPDoc ──────────
        - '#.*PHPDoc tag @.*#'

        # ── `if.alwaysFalse` en UN <Modulo>Routes: un módulo apagado, no deuda ──────────
        # SUPRESIÓN PERMANENTE. No lleva condición de retirada a propósito.
        #
        # ANTES cubría 11 casos y AHORA cubre UNO. Los otros diez eran el bloque
        # `$showSQL = false; ... if ($showSQL)`, y ya no existen: el DDL se saca con
        # `bin/cli scheme-create`, así que el interruptor escondido sobra. Ver T58.
        #
        # El que queda es `DataImportExportUtilityRoutes`, que declara `const ENABLE = false;`
        # literal: el módulo está apagado en árbol, no es un descuido. Por eso la ruta se
        # ESTRECHA a ese archivo: dejarla en `**/*Routes.php` taparía cualquier rama muerta
        # que apareciera mañana en cualquier otro módulo.
        -
            identifier: if.alwaysFalse
            paths:
                - ../src/app/classes/DataImportExportUtility/DataImportExportUtilityRoutes.php
        # ── Dead catch: DOS casos reales, y el desajuste que los explica ──────────
        # `catch.neverThrown` era una supresión de familia entera. Se miraron los cinco:
        # TRES eran muertos de verdad y se han borrado —un try alrededor de una asignación
        # de cadena, otro con el cuerpo entero comentado, y un `$exception->getCode()`—.
        # Los dos que quedan son ALCANZABLES EN EJECUCIÓN, cada uno por una razón distinta,
        # y en las dos PHPStan tiene razón mirando solo el lenguaje:
        #
        #   1. LoginAttemptsModel: `$mapper->extra_data = ...` pasa por `__set()`, que
        #      lanza `DatabaseClassesExceptions`. PHPStan no ve a través de los métodos
        #      mágicos.
        #   2. AppHelpers: `$roles[$e]` sobre una clave inexistente emite un E_WARNING, no
        #      una excepción — pero el manejador de `bootstrap.php` PROMUEVE E_WARNING A
        #      EXCEPCIÓN, así que ese catch sí se alcanza.
        #
        # NO se puede expresar en configuración: se probó
        # `exceptions.reportUncheckedExceptionDeadCatch: false` y no mueve ninguno, porque
        # el desajuste no es de excepciones comprobadas, es que PHPStan modela el LENGUAJE
        # y aquí manda además el manejador de errores.
        #
        # Por eso son dos supresiones por ruta y no una de familia: la próxima que aparezca
        # tiene que mirarse, no heredar el silencio.
        -
            identifier: catch.neverThrown
            paths:
                - ../src/app/model/LoginAttemptsModel.php
                - ../src/app/core/AppHelpers.php

        # ── Diseño estricto ──────────
        - identifier: return.void
        - identifier: return.unusedType
        - identifier: method.unused
        - identifier: staticMethod.resultUnused
        - identifier: property.unusedType
