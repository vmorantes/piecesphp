#!/bin/bash

# Análisis estático en la ÚNICA versión de PHP que el proyecto soporta: 8.5 (ADR 0020).
#
# PASADA ÚNICA 8.5, con `phpVersion` FIJO derivado de bin/phpstan.neon. Nunca un RANGO: un rango
# reporta solo lo que es error en TODAS sus versiones —la INTERSECCIÓN— y así se escaparon nueve
# llamadas deprecadas en 8.5 durante la campaña. Si vuelve a soportarse otra versión, se repone la
# unión de pasadas (ver la reversión del ADR 0020).

set -o pipefail

# QUÉ PHP SE USA. Por defecto, EL QUE SIRVE EL NAVEGADOR: durante toda la campaña estas
# herramientas corrieron con php8.4 mientras Apache servía 8.5.9, así que las suites NUNCA
# pisaron la versión de producción y las deprecaciones de 8.5 eran invisibles.
#
# Se puede fijar otra con PCSPHP_PHP_BIN, que es lo que permite correrlas en las dos:
#   PCSPHP_PHP_BIN=php8.4 bin/cli unit-tests:core/mapper-finders
if [ -n "$PCSPHP_PHP_BIN" ]; then
    PHP_BIN="$PCSPHP_PHP_BIN"
elif command -v php8.5 >/dev/null 2>&1; then
    PHP_BIN="php8.5"
elif command -v php8.4 >/dev/null 2>&1; then
    PHP_BIN="php8.4"
else
    PHP_BIN="php"
fi

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$SCRIPT_DIR/.."

REPORT_FILE=PHPStanResult.txt
REPORT_JSON=PHPStanResult.json
ANALYSE="bin/tools/vendor/bin/phpstan analyse --autoload-file=$SCRIPT_DIR/../src/vendor/autoload.php --memory-limit 2000M"

# 1. La configuración de la pasada, derivada de bin/phpstan.neon y no duplicada: así no puede
#    quedarse atrás cuando alguien toque los ignores.
for VERSION in 80500; do
    $PHP_BIN -r '
        $c = str_replace("\r\n", "\n", (string) file_get_contents("bin/phpstan.neon"));
        if (preg_match("/^    phpVersion:\n(?:        .*\n)+/m", $c, $m) !== 1) {
            fwrite(STDERR, "No se encontró el bloque phpVersion en bin/phpstan.neon.\n");
            exit(1);
        }
        $replacement = "    phpVersion:\n        min: " . $argv[1] . "\n        max: " . $argv[1] . "\n";
        file_put_contents($argv[2], str_replace("\n", "\r\n", str_replace($m[0], $replacement, $c)));
    ' "$VERSION" "bin/phpstan.$VERSION.generated.neon" || exit 1
done

# 2. La tabla legible, de la pasada. Es para leerla; el dato manda en el JSON.
#    NO QUITAR COLUMNS: sin él la tabla recorta las rutas al ancho de terminal.
COLUMNS=400 PHPSTAN_TABLE_ERROR_FORMATTER_FORCE_SHOW_ALL_ERRORS=1 \
    $PHP_BIN $ANALYSE -c bin/phpstan.80500.generated.neon > "$REPORT_FILE"

# 3. La pasada de máquina.
$PHP_BIN $ANALYSE -c bin/phpstan.80500.generated.neon --error-format=json --no-progress > PHPStanResult.8.5.json 2>/dev/null

# 4. PHPStanResult.json, deduplicado por (ruta, línea, mensaje) y con la versión anotada en cada error.
$PHP_BIN -r '
    $load = function (string $file): array {
        $json = json_decode((string) @file_get_contents($file), true);
        return is_array($json) && isset($json["files"]) && is_array($json["files"]) ? $json["files"] : [];
    };
    $sources = ["8.5" => $load("PHPStanResult.8.5.json")];
    if (count($sources["8.5"]) === 0) {
        fwrite(STDERR, "La pasada devolvió cero archivos: la medición NO se hizo.\n");
        exit(1);
    }
    $union = [];
    foreach ($sources as $version => $files) {
        foreach ($files as $path => $data) {
            foreach ($data["messages"] as $message) {
                $key = $path . "|" . $message["line"] . "|" . $message["message"];
                if (!isset($union[$key])) {
                    $union[$key] = ["path" => $path, "message" => $message, "versions" => []];
                }
                if (!in_array($version, $union[$key]["versions"], true)) {
                    $union[$key]["versions"][] = $version;
                }
            }
        }
    }
    $files = [];
    $total = 0;
    foreach ($union as $entry) {
        $message = $entry["message"];
        $message["phpVersions"] = $entry["versions"];
        $files[$entry["path"]]["messages"][] = $message;
        $total++;
    }
    foreach ($files as $path => $data) {
        $files[$path]["errors"] = count($data["messages"]);
    }
    ksort($files);
    file_put_contents("PHPStanResult.json", json_encode([
        "totals" => ["errors" => 0, "file_errors" => $total],
        "files" => $files,
        "errors" => [],
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
' || exit 1

rm -f bin/phpstan.80500.generated.neon

# 5. Resumen y trinquete, a partir de PHPStanResult.json.
$PHP_BIN "$SCRIPT_DIR/phpstan-process-result.php" "$@"
