#!/usr/bin/env php
<?php

/**
 * SQL CONCATENADO QUE PUEDE VENIR DE LA PETICION.
 *
 * POR QUE EXISTE
 * --------------
 * `Country::search()` arma su `WHERE` interpolando un valor que sale de `getQueryParams()`:
 *
 *     $critery = "UPPER({$table}.name) LIKE UPPER('{$query}%')";
 *     $model->select()->where($whereString);
 *
 * `ActiveRecord::where(string)` CONCATENA —`$this->whereSegment = "WHERE ({$where})"`— mientras
 * que `where(array)` y `where(WhereSegment)` arman marcadores y se preparan. La via segura ya
 * existe; la sobrecarga de cadena la evita. Y `clean_string()` NO escapa comillas: su propio
 * docblock enumera lo que quita, y las comillas no estan en la lista.
 *
 * LEY 11: la regla que fallo se convierte en mecanismo. Esto es el mecanismo.
 *
 * QUE MIDE
 * --------
 * Las OCHO familias de `const FAMILIAS`, que es donde esta escrito cual es el argumento
 * peligroso de cada una y si un array la salva. De cada llamada cuyo argumento no sea literal,
 * array seguro o segmento preparado, traza hacia atras DENTRO DEL MISMO METODO buscando si la
 * cadena se compone con algo que venga de la peticion.
 *
 * SE CUENTA POR TOKENS, NO POR TEXTO. Una llamada dentro de una cadena o de un comentario no es
 * una llamada: en el bloque AI una cifra salio inflada por los docblocks recien escritos.
 *
 * Cuatro listas, y la clasificacion se dice, no se insinua:
 *   CONFIRMADO ...... la cadena llega a una fuente de peticion por asignaciones del metodo
 *   DECLARADO ....... concatena porque la comparacion es de LISTA y la biblioteca no
 *                     parametriza `IN`; su validacion de dominio esta escrita aparte
 *   REVISAR A MANO .. no es literal y la traza no alcanza a decidir
 *   DESCARTADO ...... literal constante, array seguro o segmento preparado
 *
 * SU COTA, Y SE IMPRIME (LEY 15)
 * ------------------------------
 * NO sigue una variable que cruce de metodo o de clase: una propiedad, un parametro o el
 * `return` de otro sitio se quedan en REVISAR A MANO. Tampoco resuelve indices de array ni
 * variables variables. Un censo que calle su ceguera miente. El listado de familias que
 * SIGUEN sin mirarse se imprime al final, y sale de leer el paquete.
 *
 * Uso:
 *   bin/censo-sql-concatenado             las tres listas
 *   bin/censo-sql-concatenado --detalle   con la traza de cada REVISAR
 *   bin/censo-sql-concatenado --trinquete compara CONFIRMADO contra la linea base y FALLA
 *                                         si ha crecido
 */

const RAIZ = __DIR__ . '/../src/app';

//FUERA, y por su nombre: lo descargado, lo generado y los registros. Un filtro es parte del
//universo, asi que se imprime junto al resultado.
const EXCLUIDOS = ['/vendor/', '/node_modules/', '/bin/tools/', '/logs/', '/cache/', '/dumps/'];

//Lo que trae datos de fuera. `getValue` NO esta aqui: se alcanza por el objeto contaminado.
const FUENTES = ['getQueryParam', 'getQueryParams', 'getParsedBody', 'getAttribute',
                 '$_GET', '$_POST', '$_REQUEST', '$_COOKIE'];

/**
 * LAS FAMILIAS QUE CONCATENAN, Y CUAL ES SU ARGUMENTO PELIGROSO.
 *
 * `arg`     indice del argumento que acaba en el SQL. En `join()` es el SEGUNDO: el primero
 *           es la tabla, que tambien se concatena pero no es un valor de comparacion.
 * `array`   si pasar un array corta el riesgo. AQUI ESTA LA TRAMPA Y POR ESO SE DECLARA:
 *           en `where()` un array construye marcadores, pero en `orderBy()` y `groupBy()`
 *           el array se recorre con `implode(', ', ...)` y ACABA EN LA CADENA IGUAL.
 *           Un censo que reutilizara el atajo de `where` daria por limpias 4 llamadas.
 * `seguros` clases cuyo uso desvia el valor a marcador. `orderBy` y `groupBy` NO TIENEN
 *           NINGUNA: la biblioteca no ofrece segmento preparado para ordenar ni agrupar.
 *
 * `leftJoin`, `rightJoin` e `innerJoin` ENTRAN: `ActiveRecord.php:350-379` los reenvia a
 * `join()` con el mismo `$on`, asi que comparten la rama de string.
 */
const FAMILIAS = [
    'where'     => ['arg' => 0, 'array' => true,  'seguros' => ['WhereSegment', 'WhereItem', 'HavingSegment', 'HavingItem']],
    'having'    => ['arg' => 0, 'array' => true,  'seguros' => ['WhereSegment', 'WhereItem', 'HavingSegment', 'HavingItem']],
    'orderBy'   => ['arg' => 0, 'array' => false, 'seguros' => []],
    'groupBy'   => ['arg' => 0, 'array' => false, 'seguros' => []],
    'join'      => ['arg' => 1, 'array' => true,  'seguros' => ['JoinSegment', 'JoinItem']],
    'leftJoin'  => ['arg' => 1, 'array' => true,  'seguros' => ['JoinSegment', 'JoinItem']],
    'rightJoin' => ['arg' => 1, 'array' => true,  'seguros' => ['JoinSegment', 'JoinItem']],
    'innerJoin' => ['arg' => 1, 'array' => true,  'seguros' => ['JoinSegment', 'JoinItem']],
];

/**
 * LA NOVENA FAMILIA, QUE NO ES UNA LLAMADA.
 *
 * `DataTablesHelper::process()` recibe un ARRAY LITERAL, y tres de sus claves son fragmentos de
 * SQL que el helper concatena tal cual: `"($where_string) AND $where"` (linea 277) y sus dos
 * gemelas. Como no hay `->where(` en el sitio, las ocho familias de llamada NO LAS VEN — y por
 * eso el bloque AN encontro a mano cuatro concatenaciones que el censo daba por inexistentes.
 *
 * Se busca la CLAVE, no la llamada que la envuelve: asi tambien entran los envoltorios como
 * `dataTablesResponse()` de `config/functions.php`, que reenvia el array sin ser `process()`.
 */
const CLAVES_FRAGMENTO = ['where_string', 'having_string', 'group_string'];

/**
 * LOS OPERADORES QUE NO SE PREPARAN NI DENTRO DE UN SEGMENTO.
 *
 * `WhereItem::NOT_ALIAS_OPERATORS` deja a estos tres SIN generar marcador, y `toString()`
 * imprime su `$rightMember` EN CRUDO. Meterlos en un `WhereSegment` NO los salva.
 *
 * Sin esto, arreglar `UsersController::searchDropdown` habria BORRADO su hallazgo del censo
 * en vez de declararlo: el `NOT IN` seguia crudo y la cifra bajaba sola. Un instrumento que
 * premia envolver el problema es peor que no tenerlo.
 */
const OPERADORES_CRUDOS = ['IN_OPERATOR', 'NOT_IN_OPERATOR', 'FIND_IN_SET_OPERATOR'];

function tieneOperadorCrudo(string $expresion): bool
{
    foreach (OPERADORES_CRUDOS as $op) {
        if (mb_strpos($expresion, $op) !== false) {
            return true;
        }
    }
    return false;
}

/**
 * Igual que la anterior, pero SIGUIENDO LAS VARIABLES de la expresion.
 *
 * Hace falta porque el operador casi nunca esta en el argumento: en
 * `UsersController::searchDropdown` el argumento es `new WhereSegment($criteriosWhere)` y el
 * `NOT_IN_OPERATOR` vive en una de las asignaciones de esa variable. Mirar solo el texto del
 * argumento dejaba pasar el atajo; mirar todo el metodo condenaba de paso al `having`, que SI
 * va por marcador. La cadena de variables es la unidad correcta.
 */
function crudoEnCadena(string $expresion, array $mapa, array $vistas = [], int $profundidad = 0): bool
{
    if (tieneOperadorCrudo($expresion)) {
        return true;
    }
    if ($profundidad > 6) {
        return false;
    }
    preg_match_all('/\$[A-Za-z_]\w*/', $expresion, $m);
    foreach ($m[0] as $var) {
        if (in_array($var, $vistas, true) || !array_key_exists($var, $mapa)) {
            continue;
        }
        $vistas[] = $var;
        foreach ($mapa[$var] as $rhs) {
            if (crudoEnCadena($rhs, $mapa, $vistas, $profundidad + 1)) {
                return true;
            }
        }
    }
    return false;
}

/**
 * Parte los argumentos de una llamada por las comas DE PRIMER NIVEL. Una coma dentro de un
 * array, de otra llamada o de una cadena no separa argumentos.
 *
 * @return string[]
 */
function separaArgumentos(array $tokens, int $desde, int $hasta): array
{
    $partes = [];
    $actual = '';
    $prof = 0;
    for ($i = $desde; $i <= $hasta && $i < count($tokens); $i++) {
        $t = is_array($tokens[$i]) ? $tokens[$i][1] : $tokens[$i];
        if ($t === '(' || $t === '[' || $t === '{') {
            $prof++;
        }
        if ($t === ')' || $t === ']' || $t === '}') {
            $prof--;
        }
        if ($t === ',' && $prof === 0) {
            $partes[] = $actual;
            $actual = '';
            continue;
        }
        $actual .= $t;
    }
    if (trim($actual) !== '' || count($partes) > 0) {
        $partes[] = $actual;
    }
    return $partes;
}

function ficheros(string $raiz): array
{
    $salida = [];
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($raiz, FilesystemIterator::SKIP_DOTS));
    foreach ($it as $f) {
        if (!$f->isFile()) {
            continue;
        }
        $p = str_replace('\\', '/', (string) (realpath($f->getPathname()) ?: $f->getPathname()));
        if (!str_ends_with($p, '.php')) {
            continue;
        }
        foreach (EXCLUIDOS as $x) {
            if (mb_strpos($p, $x) !== false) {
                continue 2;
            }
        }
        $salida[] = $p;
    }
    sort($salida);
    return $salida;
}

/** @return array<int,array{nombre:string,ini:int,fin:int}> */
function metodos(array $tokens): array
{
    $total = count($tokens);
    $salida = [];
    for ($i = 0; $i < $total; $i++) {
        if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_FUNCTION) {
            continue;
        }
        $nombre = '(anonima)';
        for ($j = $i + 1; $j < $total; $j++) {
            $u = $tokens[$j];
            if (is_array($u) && in_array($u[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
                continue;
            }
            if (is_array($u) && $u[0] === T_STRING) {
                $nombre = $u[1];
            }
            break;
        }
        $abierto = false;
        $prof = 0;
        $ini = $fin = null;
        for ($j = $i + 1; $j < $total; $j++) {
            $texto = is_array($tokens[$j]) ? $tokens[$j][1] : $tokens[$j];
            if (!$abierto) {
                if ($texto === ';') {
                    break;
                }
                if ($texto === '{') {
                    $abierto = true;
                    $prof = 1;
                    $ini = $j;
                }
                continue;
            }
            if ($texto === '{') {
                $prof++;
            }
            if ($texto === '}') {
                $prof--;
                if ($prof === 0) {
                    $fin = $j;
                    break;
                }
            }
        }
        if ($ini !== null && $fin !== null) {
            $salida[] = ['nombre' => $nombre, 'ini' => $ini, 'fin' => $fin];
        }
    }
    return $salida;
}

function texto(array $tokens, int $desde, int $hasta): string
{
    $s = '';
    $n = count($tokens);
    for ($i = $desde; $i <= $hasta && $i < $n; $i++) {
        $s .= is_array($tokens[$i]) ? $tokens[$i][1] : $tokens[$i];
    }
    return $s;
}

function tieneFuente(string $expresion): bool
{
    foreach (FUENTES as $f) {
        if (mb_strpos($expresion, $f) !== false) {
            return true;
        }
    }
    return false;
}

/** @return array<string,string[]> */
function asignaciones(array $tokens, int $ini, int $fin): array
{
    $mapa = [];
    for ($i = $ini; $i <= $fin; $i++) {
        if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_VARIABLE) {
            continue;
        }
        $var = $tokens[$i][1];
        $j = $i + 1;
        if (($tokens[$j] ?? null) === '[' && (($tokens[$j + 1] ?? null) === ']')) {
            $j += 2;
        }
        while (is_array($tokens[$j] ?? null) && $tokens[$j][0] === T_WHITESPACE) {
            $j++;
        }
        $op = $tokens[$j] ?? null;
        if ($op !== '=' && !(is_array($op) && $op[0] === T_CONCAT_EQUAL)) {
            continue;
        }
        $k = $j + 1;
        $prof = 0;
        while ($k <= $fin) {
            $t = is_array($tokens[$k]) ? $tokens[$k][1] : $tokens[$k];
            if ($t === '(' || $t === '[') {
                $prof++;
            }
            if ($t === ')' || $t === ']') {
                $prof--;
            }
            if ($t === ';' && $prof <= 0) {
                break;
            }
            $k++;
        }
        $mapa[$var][] = texto($tokens, $j + 1, $k - 1);
    }
    return $mapa;
}

/**
 * Objetos a los que se les paso una fuente de peticion: lo que devuelvan se considera sucio.
 * `Country::search()` pasa por aqui —`$expectedParameters->setInputValues($request->getQueryParams())`—
 * y ninguna busqueda por nombre habria unido eso con `$query = $expectedParameters->getValue(...)`.
 *
 * @return string[]
 */
function objetosContaminados(array $tokens, int $ini, int $fin): array
{
    $sucios = [];
    for ($i = $ini; $i <= $fin; $i++) {
        if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_VARIABLE) {
            continue;
        }
        if (!is_array($tokens[$i + 1] ?? null) || $tokens[$i + 1][0] !== T_OBJECT_OPERATOR) {
            continue;
        }
        $k = $i + 1;
        $prof = 0;
        while ($k <= $fin) {
            $t = is_array($tokens[$k]) ? $tokens[$k][1] : $tokens[$k];
            if ($t === '(') {
                $prof++;
            }
            if ($t === ')') {
                $prof--;
            }
            if ($t === ';' && $prof <= 0) {
                break;
            }
            $k++;
        }
        if (tieneFuente(texto($tokens, $i, $k))) {
            $sucios[] = $tokens[$i][1];
        }
    }
    return array_values(array_unique($sucios));
}

/** @return array{0:string,1:string[]} */
function resuelve(string $expresion, array $mapa, array $sucios, array &$vistas, array $seguros = [], int $profundidad = 0): array
{
    if ($profundidad > 6) {
        return ['REVISAR', ['traza cortada a profundidad 6']];
    }
    //LA VIA SEGURA CORTA LA TRAZA. Un valor que entra en un `WhereSegment` o un `WhereItem`
    //sale por marcador, venga de donde venga. Sin esto el censo marcaria el codigo ARREGLADO.
    //LA LISTA LA PONE LA FAMILIA: `orderBy` y `groupBy` la traen VACIA porque no existe
    //segmento preparado para ellas, y heredar la de `where` habria callado sus hallazgos.
    foreach ($seguros as $seguro) {
        if (mb_strpos($expresion, $seguro) !== false && !crudoEnCadena($expresion, $mapa)) {
            return ['DESCARTADO', ["el valor entra en un {$seguro}: va por marcador"]];
        }
    }
    if (tieneFuente($expresion)) {
        return ['CONFIRMADO', ['fuente directa en: ' . trim($expresion)]];
    }
    foreach ($sucios as $obj) {
        if (mb_strpos($expresion, $obj . '->') !== false) {
            return ['CONFIRMADO', ["sale de {$obj}, que recibió una fuente de petición"]];
        }
    }
    $traza = [];
    $indeciso = false;
    preg_match_all('/\$[A-Za-z_]\w*/', $expresion, $m);
    foreach ($m[0] as $var) {
        if (in_array($var, $vistas, true)) {
            continue;
        }
        if (!array_key_exists($var, $mapa)) {
            //LA COTA: parametro, propiedad o algo de fuera del metodo.
            $indeciso = true;
            $traza[] = "{$var} no se asigna en este método (parámetro, propiedad o llamada externa)";
            continue;
        }
        $vistas[] = $var;
        foreach ($mapa[$var] as $rhs) {
            [$v, $t] = resuelve($rhs, $mapa, $sucios, $vistas, $seguros, $profundidad + 1);
            if ($v === 'CONFIRMADO') {
                return ['CONFIRMADO', array_merge(["{$var} = " . trim($rhs)], $t)];
            }
            if ($v === 'REVISAR') {
                $indeciso = true;
                $traza = array_merge($traza, ["{$var} = " . trim($rhs)], $t);
            }
        }
    }
    return [$indeciso ? 'REVISAR' : 'DESCARTADO', $traza];
}

function analiza(string $codigo, string $ruta = '(fixture)'): array
{
    $tokens = token_get_all($codigo);
    $hallazgos = [];
    foreach (metodos($tokens) as $metodo) {
        $mapa = asignaciones($tokens, $metodo['ini'], $metodo['fin']);
        $sucios = objetosContaminados($tokens, $metodo['ini'], $metodo['fin']);
        //`extract()` CREA VARIABLES QUE NINGUN TOKEN ASIGNA. Con el en el metodo, el mapa de
        //asignaciones esta INCOMPLETO, y un DESCARTADO sacado de ese mapa es un falso limpio:
        //asi salia limpio el `groupBy($group_string)` de `DataTablesHelper`. Se degrada a
        //REVISAR. El DESCARTADO estructural —array, segmento, literal— no depende del mapa y
        //se queda como esta.
        $cuerpo = texto($tokens, $metodo['ini'], $metodo['fin']);
        $hayExtract = preg_match('/\bextract\s*\(/', $cuerpo) === 1;
        for ($i = $metodo['ini']; $i <= $metodo['fin']; $i++) {
            if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_OBJECT_OPERATOR) {
                continue;
            }
            $sig = $tokens[$i + 1] ?? null;
            //`having(string)` CONCATENA IGUAL que `where(string)`: `"HAVING ({$having})"`. La
            //primera version solo miraba `where(` y `City::search()` se colaba por eso. LEY 15.
            if (!is_array($sig) || $sig[0] !== T_STRING || !array_key_exists($sig[1], FAMILIAS)) {
                continue;
            }
            $metodoLlamado = $sig[1];
            $familia = FAMILIAS[$metodoLlamado];
            $abre = $i + 2;
            while (is_array($tokens[$abre] ?? null) && $tokens[$abre][0] === T_WHITESPACE) {
                $abre++;
            }
            if (($tokens[$abre] ?? null) !== '(') {
                continue;
            }
            $prof = 0;
            $cierra = $abre;
            for ($j = $abre; $j <= $metodo['fin']; $j++) {
                $t = is_array($tokens[$j]) ? $tokens[$j][1] : $tokens[$j];
                if ($t === '(') {
                    $prof++;
                }
                if ($t === ')') {
                    $prof--;
                    if ($prof === 0) {
                        $cierra = $j;
                        break;
                    }
                }
            }
            $linea = $sig[2];
            $argumentos = separaArgumentos($tokens, $abre + 1, $cierra - 1);
            $indice = $familia['arg'];

            //`join($tabla)` a secas: el `$on` toma su `[]` por defecto y se va por JoinSegment.
            if (!array_key_exists($indice, $argumentos)) {
                $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                                'arg' => '(no se pasa)', 'veredicto' => 'DESCARTADO',
                                'llamada' => $metodoLlamado,
                                'traza' => ['el argumento no se pasa: toma su valor por defecto']];
                continue;
            }
            $argumento = trim($argumentos[$indice]);

            $esArray = str_starts_with($argumento, '[') || str_starts_with($argumento, 'array(');
            $esSegmento = false;
            foreach ($familia['seguros'] as $seguro) {
                if (mb_strpos($argumento, $seguro) !== false) {
                    $esSegmento = true;
                }
            }
            //UN SEGMENTO CON `IN`, `NOT IN` o `FIND_IN_SET` NO SALVA NADA: esos tres imprimen
            //su valor en crudo. El atajo se anula y la llamada se traza como cualquier otra.
            if ($esSegmento && crudoEnCadena($argumento, $mapa)) {
                $esSegmento = false;
            }
            if ($argumento === '' || $esSegmento || ($esArray && $familia['array'])) {
                $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                                'arg' => $argumento, 'veredicto' => 'DESCARTADO',
                                'llamada' => $metodoLlamado,
                                'traza' => ['array o segmento preparado: va por marcadores']];
                continue;
            }
            if (preg_match('/^([\'"]).*\1$/s', $argumento) === 1 && mb_strpos($argumento, '$') === false) {
                $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                                'arg' => $argumento, 'veredicto' => 'DESCARTADO',
                                'llamada' => $metodoLlamado, 'traza' => ['cadena literal constante']];
                continue;
            }
            //SIN VARIABLES Y SIN FUENTE no hay por donde entre nada de la peticion. Hace falta
            //para `orderBy(['a ASC','b DESC'])`, que es array pero NO va por marcador.
            if (!tieneFuente($argumento) && mb_strpos($argumento, '$') === false) {
                $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                                'arg' => $argumento, 'veredicto' => 'DESCARTADO',
                                'llamada' => $metodoLlamado,
                                'traza' => ['sin variables ni fuente de petición']];
                continue;
            }

            $vistas = [];
            [$veredicto, $traza] = resuelve($argumento, $mapa, $sucios, $vistas, $familia['seguros']);
            if ($veredicto === 'DESCARTADO' && $hayExtract) {
                $veredicto = 'REVISAR';
                $traza[] = 'el método usa extract(): el mapa de asignaciones está incompleto';
            }
            $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                            'arg' => $argumento, 'veredicto' => $veredicto,
                            'llamada' => $metodoLlamado, 'traza' => $traza];
        }

        //──── LA NOVENA FAMILIA: la clave de un array, no una llamada ───────────────────────
        for ($i = $metodo['ini']; $i <= $metodo['fin']; $i++) {
            if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_CONSTANT_ENCAPSED_STRING) {
                continue;
            }
            $clave = trim($tokens[$i][1], "'\"");
            if (!in_array($clave, CLAVES_FRAGMENTO, true)) {
                continue;
            }
            $flecha = $i + 1;
            while (is_array($tokens[$flecha] ?? null) && $tokens[$flecha][0] === T_WHITESPACE) {
                $flecha++;
            }
            if (!is_array($tokens[$flecha] ?? null) || $tokens[$flecha][0] !== T_DOUBLE_ARROW) {
                continue;
            }
            //EL VALOR LLEGA HASTA LA COMA DE PRIMER NIVEL, o hasta que se cierra el array que lo
            //contiene. Una coma dentro de una funcion anonima —y aqui las hay— no separa nada.
            $prof = 0;
            $fin = $flecha;
            for ($j = $flecha + 1; $j <= $metodo['fin']; $j++) {
                $t = is_array($tokens[$j]) ? $tokens[$j][1] : $tokens[$j];
                if ($t === '(' || $t === '[' || $t === '{') {
                    $prof++;
                }
                if ($t === ')' || $t === ']' || $t === '}') {
                    if ($prof === 0) {
                        break;
                    }
                    $prof--;
                }
                if ($t === ',' && $prof === 0) {
                    break;
                }
                $fin = $j;
            }
            $valor = trim(texto($tokens, $flecha + 1, $fin));
            $linea = $tokens[$i][2];

            //NO HAY SEGMENTO PREPARADO QUE VALGA AQUI: es un fragmento de SQL en crudo, y el
            //helper lo interpola con `"($where_string) AND $where"`. La lista de seguros va vacia.
            if ($valor === '' || (preg_match('/^([\'"]).*\1$/s', $valor) === 1 && mb_strpos($valor, '$') === false)
                || (!tieneFuente($valor) && mb_strpos($valor, '$') === false)) {
                $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                                'arg' => $valor, 'veredicto' => 'DESCARTADO',
                                'llamada' => $clave, 'traza' => ['literal constante o sin variables']];
                continue;
            }

            $vistas = [];
            [$veredicto, $traza] = resuelve($valor, $mapa, $sucios, $vistas, []);
            if ($veredicto === 'DESCARTADO' && $hayExtract) {
                $veredicto = 'REVISAR';
                $traza[] = 'el método usa extract(): el mapa de asignaciones está incompleto';
            }
            $hallazgos[] = ['ruta' => $ruta, 'metodo' => $metodo['nombre'], 'linea' => $linea,
                            'arg' => $valor, 'veredicto' => $veredicto,
                            'llamada' => $clave, 'traza' => $traza];
        }
    }
    return $hallazgos;
}

//──── CANARIO DE DOS CARAS POR FAMILIA (LEY 16) ─────────────────────────────────────────────
//Una cara que DEBE salir y otra que NO, para CADA familia. Sin las dos, un cero no significa
//nada: podria ser que la familia esta limpia o que el censo no la mira.
$canarios = [
    ['where · la forma de `Country::search()`',
        '<?php class C { public function search($request) {'
        . ' $p = new Parameters([]); $p->setInputValues($request->getQueryParams());'
        . ' $q = $p->getValue("query"); $c = "UPPER(t.name) LIKE UPPER(\'{$q}%\')";'
        . ' $w = $c; $m->select()->where($w); } }', 'CONFIRMADO'],
    ['where · un array, que va por marcadores',
        '<?php class C { public function ok($v) { $m->select()->where(["columna" => $v]); } }', 'DESCARTADO'],
    ['having · una cadena compuesta con la petición',
        '<?php class C { public function f($request) { $s = $request->getQueryParam("s");'
        . ' $m->having("LOWER(n) LIKE \'{$s}%\'"); } }', 'CONFIRMADO'],
    ['having · un HavingSegment',
        '<?php class C { public function f($request) { $s = $request->getQueryParam("s");'
        . ' $m->having(new HavingSegment([new HavingItem("n", "LIKE", $s)])); } }', 'DESCARTADO'],
    ['orderBy · una cadena compuesta con la petición',
        '<?php class C { public function f($request) { $o = $request->getQueryParam("orden");'
        . ' $m->orderBy("{$o} ASC"); } }', 'CONFIRMADO'],
    ['orderBy · un literal constante',
        '<?php class C { public function f() { $m->orderBy("fullname ASC, id DESC"); } }', 'DESCARTADO'],
    //LA CARA QUE SEPARA LAS FAMILIAS. En `where` este array seria DESCARTADO; en `orderBy` la
    //biblioteca lo hace `implode(", ", ...)` y acaba en la cadena. Si esto sale DESCARTADO, el
    //censo ha heredado el atajo de `where` y estara callando lo que vino a buscar.
    ['orderBy · un ARRAY con un valor de la petición dentro',
        '<?php class C { public function f($request) { $o = $request->getQueryParam("orden");'
        . ' $m->orderBy(["id DESC", "{$o} ASC"]); } }', 'CONFIRMADO'],
    ['groupBy · una cadena compuesta con la petición',
        '<?php class C { public function f($request) { $g = $request->getQueryParam("g");'
        . ' $m->groupBy("t.{$g}"); } }', 'CONFIRMADO'],
    ['groupBy · un literal constante',
        '<?php class C { public function f() { $m->groupBy("users.id"); } }', 'DESCARTADO'],
    //En `join` el argumento peligroso es el SEGUNDO. La cara limpia lleva la basura en el
    //PRIMERO a proposito: si el censo mirase el argumento equivocado, saldria CONFIRMADO.
    ['join · el `$on` de tipo string compuesto con la petición',
        '<?php class C { public function f($request) { $c = $request->getQueryParam("c");'
        . ' $m->join("otra", "a.id = otra.{$c}"); } }', 'CONFIRMADO'],
    ['join · el `$on` array, con la petición en la TABLA (arg. equivocado)',
        '<?php class C { public function f($request) { $t = $request->getQueryParam("t");'
        . ' $m->join($t, ["a.id" => "b.id"]); } }', 'DESCARTADO'],
    ['leftJoin · reenvía a join() y comparte su rama de string',
        '<?php class C { public function f($request) { $c = $request->getQueryParam("c");'
        . ' $m->leftJoin("otra", "a.id = otra.{$c}"); } }', 'CONFIRMADO'],
    ['innerJoin · un JoinSegment',
        '<?php class C { public function f($request) { $c = $request->getQueryParam("c");'
        . ' $m->innerJoin("otra", new JoinSegment([new JoinItem("a.id", "=", $c)])); } }', 'DESCARTADO'],
    //LA CARA DE `extract()`. Sin la degradacion, esto sale DESCARTADO —el unico `$g` que el
    //tokenizador ve asignado es la cadena vacia— y era un falso limpio de verdad, no de fixture:
    //asi se colaba el `groupBy($group_string)` de `DataTablesHelper`.
    ['groupBy · una variable en un método con extract()',
        '<?php class C { public function f($opciones) { $g = ""; extract($opciones);'
        . ' $m->groupBy($g); } }', 'REVISAR'],
    ['groupBy · la misma variable SIN extract() en el método',
        '<?php class C { public function f($opciones) { $g = ""; $m->groupBy($g); } }', 'DESCARTADO'],
    //LA CARA DEL SEGMENTO QUE NO SALVA. `NOT IN` sigue imprimiendose en crudo dentro de un
    //`WhereSegment`. Si esto sale DESCARTADO, envolver el problema lo borra del censo.
    ['where · un WhereSegment con NOT_IN_OPERATOR y valor de la petición',
        '<?php class C { public function f($request) { $t = $request->getQueryParam("t");'
        . ' $m->where(new WhereSegment([new WhereItem("type", WhereItem::NOT_IN_OPERATOR, "({$t})")])); } }',
        'CONFIRMADO'],
    //LA NOVENA FAMILIA. La cara positiva copia la forma de `PublicationsController::dataTables`;
    //la negativa es un fragmento SIN NADA DE LA PETICION, que es lo unico que este instrumento
    //sabe reconocer como limpio. Ver la nota sobre `Organizations:1206` en T154.
    ['having_string · un fragmento compuesto con la petición',
        '<?php class C { public function dataTables($request) { $v = $request->getQueryParam("visibility");'
        . ' $having = []; if ($v !== null) { $having[] = "visibility = {$v}"; }'
        . ' $havingString = trim(implode(" ", $having));'
        . ' return DataTablesHelper::process(["request" => $request, "having_string" => $havingString]); } }',
        'CONFIRMADO'],
    ['where_string · un fragmento que NO toca la petición',
        '<?php class C { public function dataTables($request) { $t = M::TABLE;'
        . ' $whereString = "{$t}.status = " . M::ACTIVE;'
        . ' return DataTablesHelper::process(["request" => $request, "where_string" => $whereString]); } }',
        'DESCARTADO'],
    //`group_string` da CERO en el arbol. Un cero sin canario no es un resultado (LEY 16).
    ['group_string · un fragmento compuesto con la petición',
        '<?php class C { public function dataTables($request) { $g = $request->getQueryParam("g");'
        . ' return DataTablesHelper::process(["request" => $request, "group_string" => "t.{$g}"]); } }',
        'CONFIRMADO'],
    ['where · el mismo WhereSegment con un operador que SÍ prepara',
        '<?php class C { public function f($request) { $t = $request->getQueryParam("t");'
        . ' $m->where(new WhereSegment([new WhereItem("type", WhereItem::EQUAL_OPERATOR, $t)])); } }',
        'DESCARTADO'],
];
$caido = null;
foreach ($canarios as [$nombre, $fuente, $esperado]) {
    $r = analiza($fuente);
    if (count($r) !== 1 || $r[0]['veredicto'] !== $esperado) {
        $obtenido = count($r) === 1 ? $r[0]['veredicto'] : (count($r) . ' hallazgos');
        $caido = "{$nombre} — esperaba {$esperado}, obtuvo {$obtenido}";
        break;
    }
}
if ($caido !== null) {
    fwrite(STDERR, "CANARIO CAÍDO: {$caido}\n");
    fwrite(STDERR, "               EL CENSO NO SE HACE.\n");
    exit(2);
}
printf("CANARIO VIVO: %d caras sobre las 8 familias, y la que las separa —un `orderBy([...])`\n", count($canarios));
echo "              con la petición dentro SALE, mientras el mismo array en `where` NO.\n";

$detalle = in_array('--detalle', array_slice($argv, 1), true);
$archivos = ficheros(RAIZ);
$todos = [];
foreach ($archivos as $p) {
    foreach (analiza((string) file_get_contents($p), str_replace(dirname(__DIR__) . '/', '', $p)) as $h) {
        $todos[] = $h;
    }
}

//DECLARADAS: las que concatenan porque la comparacion es de LISTA y la biblioteca no
//parametriza `IN`. No desaparecen: se separan, y cada una dice que validacion la cierra.
$declaradasPath = dirname(__DIR__) . '/files/dev/sql-concat-declared.json';
$declaradasRaw = @file_get_contents($declaradasPath);
$declaradasJson = is_string($declaradasRaw) ? json_decode($declaradasRaw, true) : null;
$declaradas = [];
//`count` ES PARTE DE LA DECLARACION. Se declara por `archivo::metodo`, asi que sin el una
//concatenacion NUEVA en un metodo ya declarado entraria gratis. Se vio provocando en AM.
$declaradasCota = [];
if (is_array($declaradasJson) && isset($declaradasJson['entries']) && is_array($declaradasJson['entries'])) {
    foreach ($declaradasJson['entries'] as $entry) {
        $clave = (string) ($entry['where'] ?? '');
        $declaradas[] = $clave;
        $declaradasCota[$clave] = (int) ($entry['count'] ?? 1);
    }
}

$por = ['CONFIRMADO' => [], 'REVISAR' => [], 'DESCARTADO' => [], 'DECLARADO' => []];
$declaradasVistas = [];
foreach ($todos as $h) {
    $clave = $h['ruta'] . '::' . $h['metodo'];
    if ($h['veredicto'] === 'CONFIRMADO' && in_array($clave, $declaradas, true)) {
        $declaradasVistas[$clave] = ($declaradasVistas[$clave] ?? 0) + 1;
        //LO QUE PASE DE SU `count` NO ESTA DECLARADO: es un hallazgo nuevo y va a CONFIRMADO.
        if ($declaradasVistas[$clave] <= ($declaradasCota[$clave] ?? 1)) {
            $por['DECLARADO'][] = $h;
            continue;
        }
    }
    $por[$h['veredicto']][] = $h;
}

printf("UNIVERSO: %d archivo(s) .php bajo `src/app`\n", count($archivos));
printf("          excluidos por nombre: %s\n", implode(' ', EXCLUIDOS));
printf("          %d llamada(s) a las 8 familias que concatenan, halladas POR TOKENS\n\n", count($todos));
foreach (['CONFIRMADO', 'DECLARADO', 'REVISAR', 'DESCARTADO'] as $v) {
    printf("%-12s %d\n", $v, count($por[$v]));
}
printf("             (DECLARADO = concatena porque la comparación es de LISTA, con su validación\n");
printf("              de dominio escrita en files/dev/sql-concat-declared.json)\n\n");

//EL REPARTO POR FAMILIA. Sin el, un total quieto puede esconder que una familia entera dejo
//de mirarse: el agregado no distingue «limpia» de «no vista». LEY 15.
echo "REPARTO POR FAMILIA:\n";
printf("  %-14s %7s %11s %10s %8s %11s\n", '', 'halladas', 'confirmado', 'declarado', 'revisar', 'descartado');
foreach (array_merge(array_keys(FAMILIAS), CLAVES_FRAGMENTO) as $f) {
    $cuenta = static fn (string $v): int => count(array_filter($por[$v], static fn (array $h): bool => $h['llamada'] === $f));
    printf("  %-14s %7d %11d %10d %8d %11d\n", $f,
        $cuenta('CONFIRMADO') + $cuenta('DECLARADO') + $cuenta('REVISAR') + $cuenta('DESCARTADO'),
        $cuenta('CONFIRMADO'), $cuenta('DECLARADO'), $cuenta('REVISAR'), $cuenta('DESCARTADO'));
}
echo "\n";

foreach (['CONFIRMADO', 'DECLARADO', 'REVISAR'] as $v) {
    if (count($por[$v]) === 0) {
        continue;
    }
    echo "── {$v} " . str_repeat('─', 60) . "\n";
    foreach ($por[$v] as $h) {
        printf("  %s:%d  %s()\n", $h['ruta'], $h['linea'], $h['metodo']);
        printf("      %s(%s)\n", $h['llamada'], mb_substr($h['arg'], 0, 90));
        if ($detalle || $v === 'CONFIRMADO' || $v === 'DECLARADO') {
            foreach (array_slice($h['traza'], 0, 4) as $t) {
                printf("        · %s\n", mb_substr($t, 0, 110));
            }
        }
    }
    echo "\n";
}

echo "SU COTA, Y SE DICE:\n";
echo "  · MIRA las 8 familias del reparto de arriba. En `join` mira SOLO el `\$on`; la TABLA,\n";
echo "    que es el primer argumento, también se concatena y aquí NO se mira.\n";
echo "  · LA NOVENA FAMILIA busca las CLAVES `where_string`, `having_string` y `group_string`\n";
echo "    en cualquier array literal, no solo en `DataTablesHelper::process(`. Del resto de\n";
echo "    claves de `\$options`, LEÍDAS en `process()`, TRES acaban también en el SQL y aquí\n";
echo "    NO se miran, porque son IDENTIFICADORES:\n";
echo "      `select_fields` .. `\$limit->select(\$select_fields)` ............... línea 333/336\n";
echo "      `columns_order` .. nombres de columna a generateOrderBy/generateHaving\n";
echo "      `custom_order` ... `\$order_by[] = \$table . \"\$column \$direction\"` .... línea 1254,\n";
echo "                         y ahí la DIRECCIÓN no pasa por el filtro ASC/DESC del `\$order`\n";
echo "  · LAS FAMILIAS QUE SIGUEN SIN CENSAR, leídas en el paquete y no supuestas:\n";
echo "      `prepare(\$sql)` ......... SQL entero en crudo ................ 71 llamadas en src/app\n";
echo "      `select(\$campos)` ....... `\$this->selectQuery = trim(\$fields)` . 194 llamadas\n";
echo "      `get(\$v,\$col,\$cols)` .... el VALOR va por `:VALUE_WHERE`, pero `\$col` y `\$cols`\n";
echo "                                se concatenan ...................... ver ActiveRecord:642\n";
echo "      `setTable(\$tabla)` ...... la tabla entra en todas las cláusulas . 6 llamadas\n";
echo "      `rowCount(\$columna)` .... `COUNT({\$column})` .................. 0 llamadas en src/app\n";
echo "    NO son valores de comparación sino IDENTIFICADORES, y por eso no se arreglan con un\n";
echo "    marcador: piden lista blanca. Es otro trabajo, y contarlo aquí sería mezclarlo.\n";
echo "  · CERRADA POR TIPO, y por eso no aparece: el `LIMIT \$from, \$perPage` de\n";
echo "    `_executeSelect()` sale de dos parámetros `?int`. PHP no deja pasar otra cosa.\n";
echo "  · La traza NO cruza de método ni de clase: una propiedad, un parámetro o el retorno de\n";
echo "    otro método caen en REVISAR A MANO, no en DESCARTADO.\n";
echo "  · Tampoco resuelve índices de array ni variables variables.\n";

if (!in_array('--trinquete', array_slice($argv, 1), true)) {
    exit(0);
}

echo "\n";
$baselinePath = dirname(__DIR__) . '/files/dev/sql-concat-baseline.json';
$crudo = @file_get_contents($baselinePath);
$baseline = is_string($crudo) ? json_decode($crudo, true) : null;
if (!is_array($baseline) || !isset($baseline['cifras']['confirmado'])) {
    //Sin linea base el trinquete no significa nada, y decirlo es mejor que pasar en verde.
    echo "TRINQUETE: no se pudo leer files/dev/sql-concat-baseline.json. SIN LÍNEA BASE NO HAY TRINQUETE.\n";
    exit(1);
}

$cota = (int) $baseline['cifras']['confirmado'];
$universo = (int) ($baseline['medido']['archivos'] ?? 0);

//EL UNIVERSO TAMBIÉN SE COMPARA: menos archivos mirados dan menos hallazgos sin que nadie haya
//arreglado nada. LEY 15.
if ($universo > 0 && $universo !== count($archivos)) {
    printf("TRINQUETE: el universo cambió — %d archivos al congelar, %d ahora. La cifra NO es comparable hasta declararlo.\n",
        $universo, count($archivos));
}

foreach ($declaradas as $clave) {
    if (!isset($declaradasVistas[$clave])) {
        printf("TRINQUETE ROTO: %s figura como declarada y ya no casa con ningún hallazgo.\n", $clave);
        printf("                Quita la entrada: la lista solo puede encoger.\n");
        exit(1);
    }
    if ($declaradasVistas[$clave] > ($declaradasCota[$clave] ?? 1)) {
        printf("TRINQUETE ROTO: %s declara %d concatenación(es) y hay %d.\n",
            $clave, $declaradasCota[$clave] ?? 1, $declaradasVistas[$clave]);
        printf("                Lo que pasa de la cota NO está declarado.\n");
        exit(1);
    }
}

$actual = count($por['CONFIRMADO']);
if ($actual > $cota) {
    printf("TRINQUETE ROTO: %d concatenaciones con valor de petición contra una cota de %d (+%d).\n", $actual, $cota, $actual - $cota);
    foreach ($por['CONFIRMADO'] as $h) {
        printf("                %s:%d %s() — %s(%s)\n", $h['ruta'], $h['linea'], $h['metodo'], $h['llamada'], mb_substr($h['arg'], 0, 50));
    }
    exit(1);
}
if ($actual < $cota) {
    printf("TRINQUETE: %d contra una cota de %d (-%d).\n", $actual, $cota, $cota - $actual);
    printf("           Baja la cota en files/dev/sql-concat-baseline.json, con la fecha y el motivo.\n");
    exit(1);
}
printf("TRINQUETE: %d concatenaciones con valor de petición, igual que la línea base.\n", $actual);
exit(0);
