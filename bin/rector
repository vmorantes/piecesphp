#!/bin/bash
SCRIPT_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
# Rector debe correr con el MISMO binario que el resto del utillaje: el `php` por
# defecto de esta máquina es 8.1.34, por debajo del piso declarado (>=8.4.1).
if command -v php8.4 >/dev/null 2>&1; then PHP_BIN=php8.4; else PHP_BIN=php; fi
$PHP_BIN $SCRIPT_DIR/tools/vendor/bin/rector process --config=$SCRIPT_DIR/tools/refactorization/Rector.php $@
