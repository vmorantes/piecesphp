#!/usr/bin/env python3
# Censo del SCSS propio por SELECTORES COMPILADOS: qué clases declara nuestro SASS y cuáles no nombra nadie.
#
# Las clases declaradas se leen del CSS que produce `gulp sass-all`, no del texto del SCSS: con el anidado, `&` y
# `&-sufijo`, el nombre final de un selector no está escrito en ninguna línea del .scss. El .css.map de cada hoja dice de
# qué archivo y línea sale cada regla, y así se agrupa por archivo de origen. Escribe files/dev/scss-census.json (ADR 0006).
#
# Uso:
#   bin/censo-scss                compila con `gulp sass-all` (no ensucia el árbol: el CSS compilado está ignorado) y censa
#   bin/censo-scss --sin-compilar censa el CSS que ya haya en disco
#   bin/censo-scss --help
#
# Cubos, por CLASE DISTINTA (no por ocurrencia):
#   VIVA               aparece como token literal en el universo de uso;
#   SIN USO LITERAL    no aparece: CANDIDATA a poda, no «muerta»;
#   SOBRESCRITURA      también la declara el CSS de un tercero (Fomantic, plugins): la pisamos, y su HTML lo genera la
#                      biblioteca. NUNCA es candidata, aparezca o no en nuestro código;
#   NO VERIFICABLE     empieza por un prefijo que algún sitio completa concatenando ('btn-' + x, "icon-{$x}"): desde el
#                      texto no se puede saber si se usa;
#   GENERADA POR TERCEROS  sin uso en lo nuestro, pero es token del JS de un tercero (src/statics/plugins/: CKEditor pone
#                      ck-editor o image-style-align-*): no es candidata (H169). Solo nombres con - o _.
#
# Lo que NO hace, y se dice para que una cifra no engañe (LEY 15):
#   - no borra nada, y no prueba que algo se pueda borrar: eso lo prueba comparar el CSS compilado antes y después;
#   - solo mira CLASES: ni @media, ni animaciones, ni variables, ni mixins, ni selectores de etiqueta o de id;
#   - no ve el HTML que llegue de la base de datos, el que escriba un clon ni el que arme un tercero con nombres nuestros;
#   - un nombre ENTERO dinámico ('ui ' + color) no se puede atribuir a ninguna clase: esos sitios se cuentan y se listan;
#   - un SUFIJO concatenado (x + '-activo') no marca nada como no verificable: solo los prefijos;
#   - las líneas de un .scss se atribuyen por el .css.map: una línea sin regla propia (una llave sola, un comentario,
#     una variable) no cuenta para nadie.
import json, os, re, shutil, subprocess, sys

OUT = 'files/dev/scss-census.json'
ROOT = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True, check=True).stdout.strip()
os.chdir(ROOT)

#Las tareas de src/gulpfile.js que llama sass-all: carpeta de las hojas -> carpeta del CSS. Los módulos cambian la
#primera «sass» de la ruta por «css» (sassCompileModules); statics/sass/imports/ no se compila (compileSassFiles).
TASKS = [
    ('src/statics/core/own-plugins/sass/', 'src/statics/core/own-plugins/css/'),
    ('src/statics/core/sass/', 'src/statics/core/css/'),
    ('src/statics/sass/', 'src/statics/css/'),
    ('src/app/classes/', 'src/app/classes/'),
]
THIRD_PARTY_DIR = 'src/statics/plugins/'
CANARY_LIVE = 'content-table'
CANARY_INVENTED = 'zz-censo-scss-canario-que-no-existe'
TOKEN_CHARS = r'A-Za-z0-9_-'


def git_files(*patterns):
    #Con lo nuevo sin preparar: gulp lo compila, así que el censo lo tiene que ver (`--exclude-standard` deja fuera lo ignorado).
    out = subprocess.run(['git', '--no-optional-locks', 'ls-files', '--cached', '--others', '--exclude-standard', '--', *patterns], capture_output=True, text=True, check=True).stdout
    return [line for line in out.splitlines() if line]


def absent_on_disk(paths):
    """Las versionadas que el censo va a leer y no están en el árbol. Un censo que se salta lo que no ve miente (LEY 16)."""
    return sorted(p for p in paths if not os.path.isfile(p))


def absent_message(absent):
    return ('PARA: ' + str(len(absent)) + ' archivo(s) versionado(s) que este censo lee no está(n) en el árbol: restáuralo(s) '
            '(git restore -- <ruta>) o prepara su borrado (git rm -- <ruta>):\n  ' + '\n  '.join(absent))


def task_of(scss):
    for base, dest in TASKS:
        if scss.startswith(base):
            if base == 'src/statics/sass/' and scss.startswith('src/statics/sass/imports/'):
                return None
            if base == 'src/app/classes/' and '/sass/' not in scss:
                return None
            return base, dest
    return None


def css_of(scss):
    task = task_of(scss)
    if task is None:
        return None
    base, dest = task
    rel = scss[len(base):]
    if base == 'src/app/classes/':
        folder, name = os.path.split(rel)
        rel = os.path.join(folder.replace('sass', 'css', 1), name)
    return dest + rel[:-len('.scss')] + '.css'


#──── Lectura del CSS ─────────────────────────────────────────────────────────────────────────────

def strip_comments(css):
    return re.sub(r'/\*.*?\*/', lambda m: ' ' * len(m.group(0)), css, flags=re.S)


def rules_of(css):
    """Reglas de estilo con su selector y su tramo [inicio, fin) en el texto. Recorre @media, @supports y demás bloques
    condicionales; salta @keyframes, @font-face y cualquier otro cuyo interior no sean reglas."""
    css = strip_comments(css)
    rules = []
    stack = []  #'rule' (con su índice en rules), 'rules' (bloque que contiene reglas) u 'other'
    prelude_start = 0
    quote = None
    i, n = 0, len(css)
    while i < n:
        c = css[i]
        if quote:
            if c == '\\':
                i += 2
                continue
            if c == quote:
                quote = None
        elif c in '"\'':
            quote = c
        elif c == '{':
            raw = css[prelude_start:i]
            prelude = raw.strip()
            parent_has_rules = all(kind == 'rules' for kind, _ in stack)
            if not parent_has_rules:
                stack.append(('other', None))
            elif prelude.startswith('@'):
                nested = re.match(r'@(media|supports|layer|container|document|-moz-document|scope)\b', prelude) is not None
                stack.append(('rules' if nested else 'other', None))
            else:
                rules.append([prelude, prelude_start + len(raw) - len(raw.lstrip()), n])
                stack.append(('rule', len(rules) - 1))
            prelude_start = i + 1
        elif c == '}':
            if stack:
                kind, index = stack.pop()
                if kind == 'rule':
                    rules[index][2] = i + 1
            prelude_start = i + 1
        elif c == ';' and all(kind == 'rules' for kind, _ in stack):
            prelude_start = i + 1
        i += 1
    return [tuple(rule) for rule in rules]


CLASS_RE = re.compile(r'\.((?:-?[_a-zA-Z]|--|\\.)(?:[_a-zA-Z0-9-]|\\.)*)')


def split_selector_list(selector):
    """Los selectores de una lista, partidos por las comas de primer nivel (no las de :is(), :not() o [..])."""
    parts, depth, current = [], 0, ''
    for c in selector:
        if c in '([':
            depth += 1
        elif c in ')]':
            depth -= 1
        if c == ',' and depth == 0:
            parts.append(current.strip())
            current = ''
        else:
            current += c
    if current.strip():
        parts.append(current.strip())
    return parts


def required_classes(complex_selector):
    """Las clases que el elemento TIENE que llevar para que el selector case: fuera de paréntesis, así que :not(.x),
    :is(.x, .y) o :has(.x) no obligan a nada."""
    flat, depth = '', 0
    for c in complex_selector:
        if c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
        elif depth == 0:
            flat += c
    return classes_of(flat)


def selector_never_matches(complex_selector, absent):
    """Un selector no casa nunca si exige al menos una clase ausente. Sin clases exigidas no se juzga."""
    return bool(required_classes(complex_selector) & absent)


def rule_never_matches(selector, absent):
    parts = split_selector_list(selector)
    return bool(parts) and all(selector_never_matches(part, absent) for part in parts)


def classes_of(selector):
    selector = re.sub(r'\[[^\]]*\]', ' ', selector)
    selector = re.sub(r'"[^"]*"|\'[^\']*\'', ' ', selector)
    return {re.sub(r'\\(.)', r'\1', m.group(1)) for m in CLASS_RE.finditer(selector)}


#──── Mapas de origen ─────────────────────────────────────────────────────────────────────────────

B64 = {c: i for i, c in enumerate('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/')}


def vlq(segment):
    values, shift, value = [], 0, 0
    for c in segment:
        digit = B64[c]
        value += (digit & 31) << shift
        if digit & 32:
            shift += 5
        else:
            values.append(-(value >> 1) if value & 1 else value >> 1)
            shift, value = 0, 0
    return values


def decode_map(mappings):
    """Por línea generada, la lista de (columna, fuente, línea de origen), todo en base 0."""
    lines, src, oline = [], 0, 0
    for gline in mappings.split(';'):
        col, segs = 0, []
        for seg in gline.split(','):
            if not seg:
                continue
            v = vlq(seg)
            col += v[0]
            if len(v) >= 4:
                src += v[1]
                oline += v[2]
                segs.append((col, src, oline))
        lines.append(segs)
    return lines


def utf16_col(text, offset, line_start):
    return len(text[line_start:offset].encode('utf-16-le')) // 2


#──── Universo de uso ─────────────────────────────────────────────────────────────────────────────

def usage_files():
    files = []
    for path in git_files('src/app', 'src/index.php'):
        if path.startswith('src/app/logs/'):
            continue
        if re.search(r'\.(php|js|ts|html|json)$', path) and not path.endswith('.min.js'):
            files.append(path)
    for path in git_files('src/statics'):
        if re.search(r'/(plugins|vendor|node_modules)/', path) or path.endswith('.min.js'):
            continue
        if re.search(r'\.(js|ts)$', path):
            files.append(path)
    return sorted(set(files))


CONCAT_PATTERNS = [
    ('js', re.compile(r'([\'"])[^\'"\n]*?([' + TOKEN_CHARS + r']*[A-Za-z][' + TOKEN_CHARS + r']*[-_])\1\s*\+')),
    ('js', re.compile(r'`[^`]*?([' + TOKEN_CHARS + r']*[A-Za-z][' + TOKEN_CHARS + r']*[-_])\$\{')),
    ('php', re.compile(r'([\'"])[^\'"\n]*?([' + TOKEN_CHARS + r']*[A-Za-z][' + TOKEN_CHARS + r']*[-_])\1\s*\.\s*[\$A-Za-z(]')),
    ('php', re.compile(r'"[^"\n]*?([' + TOKEN_CHARS + r']*[A-Za-z][' + TOKEN_CHARS + r']*[-_])(?:\{\$|\$[A-Za-z_])')),
]
WHOLE_DYNAMIC = [
    ('js', re.compile(r'class(?:Name)?\s*[=:]\s*[\'"][^\'"\n]*\s[\'"]\s*\+|addClass\(\s*[A-Za-z_$]|classList\.(?:add|toggle)\(\s*[A-Za-z_$]')),
    ('php', re.compile(r'class=[\'"][^\'"\n]*\s[\'"]\s*\.\s*\$|class="[^"\n]*\s(?:\{\$|\$[A-Za-z_])')),
]


#Un token pegado a una extensión de archivo es el nombre de un archivo, no una clase (H181).
FILE_NAME = re.compile(r'(?<![' + TOKEN_CHARS + r'])[' + TOKEN_CHARS + r']+\.(?:css|scss|js|ts|php|map|png|jpe?g|svg|webp|gif|json|html|md|woff2?)\b')


#──── Sin comentarios ─────────────────────────────────────────────────────────────────────────────
#Un comentario no es el uso de una clase: «sin ui-pcs para que el tema pinte» (header.php:87) la daba viva (H181).
#El PHP lo trocea el propio PHP (token_get_all), el de las herramientas: PCSPHP_PHP_BIN, php8.5 o php8.4, como bin/cli.
PHP_STRIP = r"""
$salida = [];
foreach (preg_split('/\n/', stream_get_contents(STDIN), -1, PREG_SPLIT_NO_EMPTY) as $ruta) {
    $texto = '';
    foreach (token_get_all(file_get_contents($ruta)) as $t) {
        if (!is_array($t)) { $texto .= $t; continue; }
        if ($t[0] === T_COMMENT || $t[0] === T_DOC_COMMENT) { $texto .= str_repeat("\n", substr_count($t[1], "\n")); continue; }
        if ($t[0] === T_INLINE_HTML) {
            $t[1] = preg_replace_callback('/<!--.*?-->/s', fn($m) => str_repeat("\n", substr_count($m[0], "\n")), $t[1]);
        }
        $texto .= $t[1];
    }
    $salida[$ruta] = $texto;
}
echo json_encode($salida, JSON_INVALID_UTF8_SUBSTITUTE | JSON_THROW_ON_ERROR);
"""


def php_bin():
    if os.environ.get('PCSPHP_PHP_BIN'):
        return os.environ['PCSPHP_PHP_BIN']
    for candidate in ('php8.5', 'php8.4'):
        if shutil.which(candidate):
            return candidate
    return 'php'


def php_without_comments(paths):
    """{ruta: texto sin comentarios} o None si el PHP falla (el censo para: sin esto contaría los comentarios)."""
    if not paths:
        return {}
    run = subprocess.run([php_bin(), '-r', PHP_STRIP], input='\n'.join(paths), capture_output=True, text=True)
    if run.returncode != 0:
        print(f'PARA: {php_bin()} no pudo quitar los comentarios del PHP:\n{run.stderr}')
        return None
    return json.loads(run.stdout)


def js_without_comments(text):
    """Quita // y /* */ respetando cadenas y plantillas; un literal de expresión regular con // dentro se lee mal (raro)."""
    out, i, n, quote = [], 0, len(text), None
    while i < n:
        c = text[i]
        if quote:
            out.append(c)
            if c == '\\' and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c in '\'"`':
            quote = c
        elif text.startswith('//', i):
            end = text.find('\n', i)
            i = n if end < 0 else end
            continue
        elif text.startswith('/*', i):
            end = text.find('*/', i + 2)
            end = n if end < 0 else end + 2
            out.append('\n' * text.count('\n', i, end))
            i = end
            continue
        out.append(c)
        i += 1
    return ''.join(out)

#Clases armadas con un prefijo guardado en una variable: el censo no puede resolver la variable, así que se declara aquí
#su valor (H181). Si la expresión o el valor dejan de estar en su archivo, el censo PARA: la declaración mentiría.
VARIABLE_PREFIXES = [
    {'file': 'src/statics/core/js/helpers-lib/GenericLoaderElement.js', 'expression': '${this.classPrefix}', 'value': 'ui-pcs-',
     'where': 'GenericLoaderElement.js:20', 'why': 'el cargador global arma sus clases (global-loader, box, logo, loader…) con el prefijo de la instancia'},
    {'file': 'src/statics/core/js/helpers-lib/GenericLoaderElement.js', 'expression': '${classPrefix}', 'value': 'ui-pcs-',
     'where': 'GenericLoaderElement.js:225 y :244', 'why': 'remove() y currentActive() buscan el cargador con el prefijo por defecto'},
]

def kind_of(path):
    return 'php' if path.endswith(('.php', '.html')) else 'js'


#──── Censo ───────────────────────────────────────────────────────────────────────────────────────

def main():
    if '--help' in sys.argv or '-h' in sys.argv:
        print(open(__file__, encoding='utf-8').read().split('\nimport ', 1)[0].split('\n', 1)[1].replace('# ', '').replace('#', ''))
        return 0
    #Antes de compilar: una parcial que falte haría caer gulp con un mensaje que no la nombra.
    absent = absent_on_disk(git_files('*.scss') + usage_files() + [p for p in git_files(THIRD_PARTY_DIR) if p.endswith('.css')])
    if absent:
        print(absent_message(absent))
        return 2
    if '--sin-compilar' not in sys.argv:
        compiled = subprocess.run(['gulp', 'sass-all'], cwd='src', capture_output=True, text=True)
        if compiled.returncode != 0:
            print('PARA: `gulp sass-all` falló:\n' + compiled.stdout + compiled.stderr)
            return 2
        print('compilado: gulp sass-all')

    scss_all = git_files('*.scss')
    roots = [s for s in scss_all if not os.path.basename(s).startswith('_')]
    missing, sheets = [], []
    for scss in roots:
        css = css_of(scss)
        if css is None or not os.path.isfile(css) or not os.path.isfile(css + '.map'):
            missing.append(f'{scss} -> {css}')
        else:
            sheets.append((scss, css))
    if missing:
        print('PARA: hojas sin su CSS o su mapa compilado:\n  ' + '\n  '.join(missing))
        return 2

    #Declaradas: clase -> {fuentes}, y las reglas con sus líneas de origen.
    declared = {}
    touches = {}
    rules_all = []
    sources_seen = set()
    for scss, css in sheets:
        text = open(css, encoding='utf-8').read()
        smap = json.load(open(css + '.map', encoding='utf-8'))
        #gulp escribe las fuentes del mapa relativas a la carpeta del propio .map (gulpfile.js, sassCompileAdapter).
        resolved = [os.path.normpath(os.path.join(os.path.dirname(css), source)) for source in smap['sources']]
        unresolved = [r for r in resolved if not os.path.isfile(r)]
        if unresolved:
            print(f'PARA: el mapa de {css} nombra fuentes que no existen: {unresolved}')
            return 2
        sources_seen.update(resolved)
        mapping = decode_map(smap['mappings'])
        line_starts = [0] + [m.end() for m in re.finditer(r'\n', text)]

        def position(offset):
            line = max(0, next((k for k in range(len(line_starts) - 1, -1, -1) if line_starts[k] <= offset), 0))
            return line, utf16_col(text, offset, line_starts[line])

        for selector, start, end in rules_of(text):
            classes = classes_of(selector)
            sline, scol = position(start)
            eline, ecol = position(end)
            touched = set()
            origin = None
            for gline in range(sline, min(eline, len(mapping) - 1) + 1):
                for col, src, oline in mapping[gline]:
                    after_start = gline > sline or col >= scol
                    before_end = gline < eline or col < ecol
                    if after_start and before_end:
                        touched.add((resolved[src], oline))
                    if gline == sline and col <= scol:
                        origin = (resolved[src], oline)
            if origin is not None:
                touched.add(origin)
            for name in classes:
                #El origen es el archivo donde está escrito el selector; las demás líneas que toca la regla pueden ser de
                #mixins o variables de otro archivo.
                declared.setdefault(name, set())
                if origin is not None:
                    declared[name].add(origin[0])
                touches.setdefault(name, set()).update(src for src, _ in touched)
            rules_all.append({'selector': selector, 'classes': classes, 'touched': touched, 'origin': origin})

    #Terceros.
    third = {}
    third_files = sorted(p for p in git_files(THIRD_PARTY_DIR) if p.endswith('.css'))
    for path in third_files:
        for selector, _, _ in rules_of(open(path, encoding='utf-8', errors='replace').read()):
            for name in classes_of(selector):
                third.setdefault(name, set()).add(path)

    #El JS de terceros: una clase que solo aparece ahí la pinta la biblioteca (H169).
    third_js_files = sorted(p for p in git_files(THIRD_PARTY_DIR) if p.endswith('.js'))
    third_js_tokens = set()
    for path in third_js_files:
        third_js_tokens.update(re.findall(f'[{TOKEN_CHARS}]+', open(path, encoding='utf-8', errors='replace').read()))

    #Uso.
    files = usage_files()
    tokens = set()
    texts = {}
    stripped_php = php_without_comments([path for path in files if path.endswith('.php')])
    if stripped_php is None:
        return 2
    for path in files:
        text = open(path, encoding='utf-8', errors='replace').read()
        texts[path] = text
        if path.endswith('.php'):
            text = stripped_php[path]
        elif path.endswith(('.js', '.ts')):
            text = js_without_comments(text)
        elif path.endswith('.html'):
            text = re.sub(r'<!--.*?-->', ' ', text, flags=re.S)
        #Un nombre de archivo no es el uso de una clase: «ui-pcs.css» no hace viva a «ui-pcs» (H181).
        tokens.update(t for t in re.split(r'[^' + TOKEN_CHARS + r']+', FILE_NAME.sub(' ', text)) if t)
    #Lo que arma un prefijo declarado cuenta como token (H181).
    by_variable = {}
    for entry in VARIABLE_PREFIXES:
        text = texts.get(entry['file'])
        if text is None or entry['expression'] not in text or f"'{entry['value']}'" not in text:
            print(f'PARA: el prefijo declarado {entry["expression"]} = {entry["value"]!r} ({entry["where"]}) ya no está en {entry["file"]}: '
                  'corrige VARIABLE_PREFIXES')
            return 2
        for m in re.finditer(re.escape(entry['expression']) + r'([' + TOKEN_CHARS + r']+)', text):
            name = entry['value'] + m.group(1)
            tokens.add(name)
            by_variable.setdefault(name, set()).add(entry['where'])
    odd = [name for name in declared if re.search(r'[^' + TOKEN_CHARS + r']', name)]

    def used(name):
        if name in odd:
            return any(name in text for text in texts.values())
        return name in tokens

    #El sitio se ancla por lo que casa, no por su línea: una línea añadida arriba en un controlador o un script dejaba
    #rancio el censo sin haber tocado ni una clase (H151).
    def site(path, m):
        return f'{path}: {" ".join(m.group(0).split())}'

    prefixes, concat_sites, whole_sites = {}, [], []
    for path, text in texts.items():
        kind = kind_of(path)
        for pkind, pattern in CONCAT_PATTERNS:
            if pkind != kind:
                continue
            for m in pattern.finditer(text):
                prefix = m.group(m.lastindex)
                prefixes.setdefault(prefix, []).append(site(path, m))
        for pkind, pattern in WHOLE_DYNAMIC:
            if pkind != kind:
                continue
            for m in pattern.finditer(text):
                whole_sites.append(site(path, m))

    def bucket(name):
        if name in third:
            return 'SOBRESCRITURA'
        if used(name):
            return 'VIVA'
        hits = [p for p in prefixes if name.startswith(p)]
        if hits:
            return 'NO VERIFICABLE'
        #Solo nombres compuestos: una palabra suelta («upper») sale en cualquier JS y taparía una candidata de verdad.
        if re.search('[-_]', name) and name in third_js_tokens:
            return 'GENERADA POR TERCEROS'
        return 'SIN USO LITERAL'

    #Canario (LEY 16): una clase usada a sabiendas sale viva, y una inventada no.
    #El vivo tiene que salir por el camino de tokens, no por el de respaldo de los nombres con caracteres escapados.
    canary_ok = CANARY_LIVE in declared and CANARY_LIVE in tokens and bucket(CANARY_LIVE) == 'VIVA' and not used(CANARY_INVENTED)
    #Y la regla que no puede casar: con la inventada ausente, muere el selector que la exige y vive el que no.
    absent_probe = {CANARY_INVENTED}
    logic = {
        f'.{CANARY_LIVE} .{CANARY_INVENTED}': True,
        f'.{CANARY_LIVE}.{CANARY_INVENTED}:hover': True,
        f'.{CANARY_LIVE}': False,
        f'.{CANARY_LIVE}:not(.{CANARY_INVENTED})': False,
        'body a': False,
        f'.{CANARY_INVENTED}, .{CANARY_LIVE}': False,
    }
    logic_ok = all(rule_never_matches(sel, absent_probe) == expected for sel, expected in logic.items())
    if not logic_ok:
        print('PARA: el canario de la regla que no puede casar falla: ' + ', '.join(
            f'«{sel}» -> {rule_never_matches(sel, absent_probe)}' for sel in logic))
        return 2
    if not canary_ok:
        print(f'PARA: el canario falla — «{CANARY_LIVE}» declarada: {CANARY_LIVE in declared}, '
              f'cubo: {bucket(CANARY_LIVE) if CANARY_LIVE in declared else "-"}; «{CANARY_INVENTED}» usada: {used(CANARY_INVENTED)}')
        return 2

    buckets = {name: bucket(name) for name in declared}
    candidates = {name for name, b in buckets.items() if b == 'SIN USO LITERAL'}
    unverifiable_by = {}
    for name, b in buckets.items():
        if b == 'NO VERIFICABLE':
            for p in prefixes:
                if name.startswith(p):
                    unverifiable_by.setdefault(p, []).append(name)

    #Cota inferior (ESTRICTA): las líneas que solo tocan reglas cuyas clases son TODAS candidatas.
    other_lines, cand_lines = set(), set()
    class_lines = {}
    for rule in rules_all:
        classes, touched = rule['classes'], rule['touched']
        if classes and classes <= candidates:
            cand_lines.update(touched)
            for name in classes:
                class_lines.setdefault(name, set()).update(touched)
        else:
            other_lines.update(touched)
    only_cand = cand_lines - other_lines

    #La BUENA: las líneas que solo tocan reglas que no pueden casar nunca. Ausente = SIN USO LITERAL; las de terceros y
    #las no verificables cuentan como presentes.
    dead_lines, live_lines = set(), set()
    for rule in rules_all:
        rule['dead'] = rule_never_matches(rule['selector'], candidates)
        (dead_lines if rule['dead'] else live_lines).update(rule['touched'])
    only_dead = dead_lines - live_lines
    dead_rules = [r for r in rules_all if r['dead']]
    unique_dead = {}
    for rule in dead_rules:
        if rule['origin'] is None:
            continue
        key = (rule['origin'][0], rule['origin'][1] + 1, rule['selector'])
        unique_dead.setdefault(key, set()).update(x for x in rule['touched'] if x in only_dead)

    per_scss = {}
    for scss in sorted(scss_all):
        total = sum(1 for _ in open(scss, encoding='utf-8'))
        names = sorted(n for n in candidates if scss in declared[n])
        lines = sorted(l + 1 for s, l in only_cand if s == scss)
        lines_dead = sorted(l + 1 for s, l in only_dead if s == scss)
        rules_here = sum(1 for (src, _, _) in unique_dead if src == scss)
        if names or lines or lines_dead:
            per_scss[scss] = {'lines_total': total, 'lines_strict': len(lines), 'lines_never_match': len(lines_dead),
                              'dead_rules': rules_here, 'unused_classes': names, 'lines_strict_list': lines,
                              'lines_never_match_list': lines_dead}

    counts = {b: sum(1 for v in buckets.values() if v == b) for b in ['VIVA', 'SIN USO LITERAL', 'SOBRESCRITURA', 'NO VERIFICABLE', 'GENERADA POR TERCEROS']}
    substring_too = sorted(n for n in candidates if any(n in text for text in texts.values()))

    #Salida legible.
    print('== Universo (LEY 15)')
    print(f'hojas .scss versionadas: {len(scss_all)} ({len(roots)} raíces, {len(scss_all) - len(roots)} parciales); fuentes vistas en los mapas: {len(sources_seen)}')
    not_seen = sorted(set(scss_all) - sources_seen)
    print(f'.scss que no aparece en ningún mapa: {len(not_seen)}' + (': ' + ', '.join(not_seen) if not_seen else ''))
    print(f'.css propios leídos: {len(sheets)} · .css de terceros leídos: {len(third_files)} · .js de terceros leídos: {len(third_js_files)} (en {THIRD_PARTY_DIR})')
    print(f'archivos de uso: {len(files)} — src/app (.php .js .ts .html .json, sin logs/ ni .min.js), src/index.php, '
          'y src/statics (.js .ts, sin plugins/, vendor/, node_modules ni .min.js)')
    print('excluido del uso: los .scss y .css, src/vendor/, src/statics/plugins/, node_modules, *.min.js, src/app/logs/')
    print(f'canario: «{CANARY_LIVE}» VIVA, «{CANARY_INVENTED}» sin uso, y {len(logic)} selectores de prueba de la regla que no puede casar — OK')
    print('')
    print('== Cubos, en CLASES DISTINTAS (no ocurrencias); uso = token literal [A-Za-z0-9_-] completo')
    for b, k in counts.items():
        print(f'{b:18} {k}')
    print(f'{"TOTAL":18} {len(declared)}')
    print(f'de las SIN USO, presentes como SUBCADENA de otro token: {len(substring_too)} (un grep -F sin límites las daría por vivas)')
    print('')
    print(f'== Sitios que concatenan un nombre: {sum(len(v) for v in prefixes.values())} con prefijo, {len(whole_sites)} con nombre entero dinámico (no atribuibles)')
    for p, names in sorted(unverifiable_by.items()):
        print(f'  «{p}» ({len(prefixes[p])} sitio(s)) deja NO VERIFICABLES: {", ".join(sorted(names))}')
    print('')
    total_lines = sum(sum(1 for _ in open(s, encoding='utf-8')) for s in scss_all)
    unique_rules = {(r['origin'][0], r['origin'][1], r['selector']) for r in rules_all if r['origin'] is not None}
    print('== Reglas que NO PUEDEN CASAR NUNCA (cada selector de su lista exige al menos una clase SIN USO LITERAL;')
    print('   las de terceros y las no verificables cuentan como presentes; un selector sin clases no se juzga)')
    print(f'reglas compiladas: {len(dead_rules)} muertas de {len(rules_all)} (contando cada hoja que incluye la parcial); '
          f'distintas por origen y selector: {len(unique_dead)} de {len(unique_rules)}')
    print(f'líneas que SOLO son de reglas que no pueden casar: {len(only_dead)} de {total_lines}')
    print(f'cota inferior ESTRICTA (todas las clases de la regla sin uso): {len(only_cand)} de {total_lines}')
    print('')
    print('== Por archivo de origen: no-pueden-casar / estricta / líneas del archivo, reglas muertas, clases SIN USO')
    for scss, data in sorted(per_scss.items(), key=lambda kv: (-kv[1]['lines_never_match'], -kv[1]['lines_strict'])):
        print(f'{scss}  {data["lines_never_match"]} / {data["lines_strict"]} / {data["lines_total"]}  '
              f'({data["dead_rules"]} regla(s), {len(data["unused_classes"])} clase(s))')
        if data['unused_classes']:
            print('    ' + ', '.join(data['unused_classes']))
    print('')
    print('== Las reglas que no pueden casar con más líneas propias')
    for (src, line, selector), lines in sorted(unique_dead.items(), key=lambda kv: (-len(kv[1]), kv[0]))[:10]:
        print(f'  {len(lines):3}  {src}:{line}  {selector[:120]}')

    result = {
        '_doc': 'Censo del SCSS por selectores compilados (bin/censo-scss --help). Clases distintas, uso por token literal. Candidata no es muerta: la poda la prueba la comparación del CSS compilado.',
        'universe': {
            'scss': len(scss_all), 'scss_roots': len(roots), 'css_own': len(sheets), 'css_third_party': len(third_files), 'js_third_party': len(third_js_files),
            'usage_files': len(files), 'scss_not_in_any_map': not_seen,
        },
        'canary': {'live': CANARY_LIVE, 'invented': CANARY_INVENTED},
        'counts': counts,
        'unused_also_as_substring': substring_too,
        'concat_prefixes': {p: sorted(set(v)) for p, v in sorted(prefixes.items())},
        'whole_dynamic_sites': sorted(set(whole_sites)),
        'variable_prefix_names': {name: sorted(w) for name, w in sorted(by_variable.items())},
        'classes': {
            name: {
                'bucket': buckets[name],
                'sources': sorted(declared[name]),
                'touches': sorted(touches.get(name, set())),
                **({'third_party': sorted(third[name])} if name in third else {}),
                **({'lines_strict': len({x for x in class_lines.get(name, set()) if x in only_cand})} if name in candidates else {}),
            } for name in sorted(declared)
        },
        'lines': {'total': total_lines, 'never_match': len(only_dead), 'strict': len(only_cand)},
        'rules': {'compiled': len(rules_all), 'compiled_never_match': len(dead_rules),
                  'distinct': len(unique_rules), 'distinct_never_match': len(unique_dead)},
        'dead_rules': [{'source': src, 'line': line, 'selector': selector, 'own_lines': len(lines)}
                       for (src, line, selector), lines in sorted(unique_dead.items(), key=lambda kv: (-len(kv[1]), kv[0]))],
        'per_scss': per_scss,
    }
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, 'w', encoding='utf-8', newline='\n') as handle:
        json.dump(result, handle, ensure_ascii=False, indent=4)
        handle.write('\n')
    print(f'\ncenso-scss ejecutado: {len(declared)} clase(s) en {len(sheets)} .css; escrito {OUT}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
