{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sshpass:*)",
      "Bash(git push:*)",
      "Bash(bin/push-all:*)",
      "Bash(./bin/push-all:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.git/config)",
      "Read(./secure-keys/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.agents/scripts/guardas/guardia.py\""
          }
        ]
      }
    ]
  }
}
