src/vendor/*
src/vendor-dev/*
src/statics/uploads/*
# Sondeos y volcados de diagnóstico: se generan al investigar y su sitio es
# files/dev/, nunca la raíz. Ahí sí se versionan cuando documentan algo.
/probe-*.log
/*.probe.log
# Respaldos de base de datos: datos reales, nunca se versionan.
src/dumps/
src/statics/css/*
src/statics/admin-area/css/*
src/statics/core/css/*
src/statics/core/own-plugins/css/*
src/statics/login-and-recovery/css/*
src/statics/features/avatars/css/*
**/node_modules/*
**/composer.lock
# Excepciones: src/ es la APLICACIÓN, no una librería, y bin/tools/ fija las
# herramientas de análisis. En ambos casos queremos versiones reproducibles entre
# máquinas y en despliegue — más aún desde que Symfony saltó de 6.4 a 8.1.
# Los paquetes piecesphp/* sí siguen sin lock: son librerías.
!src/composer.lock
!bin/tools/composer.lock
**/package-lock*
**/pnpm-lock*
**/.sass-cache
docs/code/phpdoc-cache-*
tasks/output
.scannerwork
vendor/**
IGNORE.md
IGNORE/
docs/*
bin/phpstan.deadcode.generated.neon
files/dev/route-inventory.json
PHPStanResult.8.4.json
PHPStanResult.8.5.json
#El rastro de la última restauración es de una máquina y un momento: no se versiona.
files/dev/last-restore.json

#La configuración LOCAL del agente: permisos que acumula cada máquina, no del proyecto.
#Se ignoraba solo por el ignore global de una máquina, y un ignore que no viaja no es una regla:
#en otro clon aparecía sin seguimiento. Ver bloque U.
.claude/settings.local.json

#Bytecode de los guiones de agentes. La guarda corre con `python3 -B` y no lo genera; esto es
#la red para quien la ejecute sin la opción. Ver ADR 0003.
**/__pycache__/

#Build de la documentación de la API: se genera con `cd src && gulp api-build` y no se versiona. Ver ADR 0006.
source-docs/api/docs-dist/
