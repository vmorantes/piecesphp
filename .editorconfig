# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.js]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = tab
indent_size = 4
[*.sh]
charset = utf-8
end_of_line = lf
insert_final_newline = false
# TODO `bin/` EN LF, como hace `.gitattributes` con `bin/* text eol=lf`.
# Antes esto nombraba cuatro guiones a mano y los otros trece caian en [*], que declara
# CRLF: abrir uno en un editor que respete este archivo lo habria dejado sin arrancar
# —`/usr/bin/env` busca «python3\r»— y git NO lo delata, porque normaliza en el indice.
# Medido con la implementacion real de editorconfig, no deducido de la especificacion.
[bin/*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
# Los escribe una herramienta que SIEMPRE pone LF, igual que declara `.gitattributes`.
# Sin esto caian en [*] —CRLF— y abrirlos en un editor conforme los reescribia enteros.
[PHPStanResult.*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
[*.lock]
charset = utf-8
end_of_line = lf
insert_final_newline = false
[{yaml,neon}]
charset = utf-8
end_of_line = crlf
indent_style = tab
indent_size = 4
