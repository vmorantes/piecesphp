# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.js]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
[*.sh]
charset = utf-8
end_of_line = lf
insert_final_newline = false
# [*] ya es LF (ADR 0012); esta sección se queda por insert_final_newline.
[bin/*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
# Los escribe una herramienta que SIEMPRE pone LF, igual que declara `.gitattributes`.
# [*] ya es LF (ADR 0012); esta sección se queda por insert_final_newline.
[PHPStanResult.*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
[*.lock]
charset = utf-8
end_of_line = lf
insert_final_newline = false
