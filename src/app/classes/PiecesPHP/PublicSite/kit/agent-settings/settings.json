{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Edit(/site/.pcs/**)",
            "Edit(**/.pcs/**)",
            "Edit(/pcs.json)",
            "Edit(/AGENTS.md)",
            "Edit(/CLAUDE.md)",
            "Edit(/PROJECT.md)",
            "Edit(/.agents/**)",
            "Edit(/.claude/**)",
            "Edit(/.cursor/**)",
            "Bash(rm -r *)",
            "Bash(rm -rf *)",
            "Bash(rm -fr *)",
            "Bash(rm -R *)",
            "Bash(rm -Rf *)",
            "Bash(rm -fR *)",
            "Bash(rm --recursive *)",
            "Bash(git reset --hard *)",
            "Bash(git clean *)",
            "Bash(git push --force *)",
            "Bash(git push -f *)",
            "Bash(git push * --force*)",
            "Bash(git push * -f*)",
            "Bash(rmdir /s *)",
            "Bash(rd /s *)",
            "Bash(del /s *)",
            "PowerShell(Remove-Item * -Recurse*)",
            "PowerShell(rmdir *)",
            "PowerShell(rd *)",
            "PowerShell(del * -Recurse*)",
            "PowerShell(git reset --hard *)",
            "PowerShell(git clean *)",
            "PowerShell(git push --force *)",
            "PowerShell(git push -f *)"
        ]
    }
}
