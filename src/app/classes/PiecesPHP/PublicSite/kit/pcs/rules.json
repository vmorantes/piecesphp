{
    "formatVersion": 1,
    "namePattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "fieldPattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
    "fragmentPattern": "^[A-Za-z][-A-Za-z0-9_:.]*$",
    "classListPattern": "^-?[_a-zA-Z][-_a-zA-Z0-9]*( +-?[_a-zA-Z][-_a-zA-Z0-9]*)*$",
    "sizesPattern": "^[-a-zA-Z0-9 (),.:%+*/]+$",
    "globalAttributes": ["class", "id", "style", "title", "role", "aria-*", "data-*"],
    "marks": {
        "pcs-part": {
            "attributes": {
                "name": { "required": true, "pattern": "name" }
            },
            "content": "empty"
        },
        "pcs-link": {
            "attributes": {
                "page": { "required": true, "pattern": "name" },
                "anchor": { "required": false, "pattern": "fragment" },
                "current-class": { "required": false, "pattern": "classList" }
            },
            "content": "inline"
        },
        "pcs-meta": {
            "attributes": {
                "structured-data": { "required": false, "values": ["off"] }
            },
            "content": "empty"
        },
        "pcs-image": {
            "attributes": {
                "brand": { "required": true, "pattern": "name", "values": ["logo", "partners", "partners-vertical", "loader-animation", "loader-logo", "loader-screen", "loader-screen-mobile"] },
                "alt": { "required": false },
                "class": { "required": false },
                "width": { "required": false, "integer": { "min": 1, "max": 10000 } },
                "height": { "required": false, "integer": { "min": 1, "max": 10000 } },
                "loading": { "required": false, "values": ["lazy", "eager"] },
                "decoding": { "required": false, "values": ["async", "sync", "auto"] },
                "sizes": { "required": false, "pattern": "sizes" }
            },
            "passesGlobalAttributes": false,
            "content": "empty"
        },
        "pcs-text": {
            "attributes": {
                "key": { "required": true }
            },
            "content": "text"
        },
        "pcs-list": {
            "attributes": {
                "resource": { "required": true, "pattern": "name" },
                "count": { "required": false, "integer": { "min": 1, "max": 100 }, "default": 10 }
            },
            "content": "template"
        },
        "pcs-form": {
            "attributes": {
                "action": { "required": true, "pattern": "name" }
            },
            "content": "any"
        }
    }
}
